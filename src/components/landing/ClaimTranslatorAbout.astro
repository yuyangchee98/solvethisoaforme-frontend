---
// Description content for the claim translator, shown below the tool on /translate-claims.
// The examples are real outputs of the model; the figures come from the evaluation on
// the model card - keep them in sync if the model is retrained.

const MODEL_URL = 'https://huggingface.co/yuyangchee98/qwen3-14b-jp-us-claims-lora';

const changes = [
  {
    name: 'Multiple dependent claims',
    summary:
      'A claim that depends on several earlier claims is split into separate claims or tied to a single parent, the way it usually is before a US filing.',
    example: {
      ja: '【請求項3】請求項1又は2に記載の照明装置を備える車両。',
      en: '3. A vehicle comprising the lighting device according to claim 1.<br>4. A vehicle comprising the lighting device according to claim 2.',
    },
  },
  {
    name: 'US claim form',
    summary: 'Preamble, transitional phrase, then the elements — numbered from 1, with no headings or commentary.',
    example: {
      ja: '【請求項1】基板と、前記基板上に設けられた発光素子とを備える照明装置。',
      en: '1. A lighting device comprising: a substrate; and a light emitting element provided on the substrate.',
    },
  },
  {
    name: 'Reference numerals',
    summary:
      'Drawing reference numerals are dropped, as they are in most US claims. Numbers that actually limit the claim — ranges, amounts — stay.',
    example: {
      ja: 'ドライブプーリ（１３）およびドリブンプーリ（１４）に巻き掛けられる金属ベルト（１５）が、…',
      en: '1. A metal belt for a continuously variable transmission, the metal belt being wound around a drive pulley and a driven pulley, …',
    },
  },
];

const faqs = [
  {
    question: 'Why not just use Google Translate or ChatGPT?',
    answer:
      "You can, and you'll get Japanese claims in English: the multiple dependencies, the reference numerals and the Japanese claim structure all come along, and you fix them by hand. This was trained on what US counsel actually filed, so the fixing is part of the translation.",
  },
  {
    question: 'How was it trained?',
    answer:
      'On 978 real patent families — the same invention filed in Japan first, then in the US. Each example pairs the Japanese claims as filed with the US claims as filed, whole claim set to whole claim set, so the model learned to translate and restructure at the same time.',
  },
  {
    question: 'How accurate is it?',
    answer:
      "It's a first draft, not a filing. On 209 applications it never saw in training, every output was in US claim form and none had multiple dependent claims. It can still pick the wrong term, drop a number or word a claim differently from counsel — and it won't add the extra claims counsel often files. The full numbers are on the model card.",
  },
  {
    question: 'Is it free?',
    answer:
      'Yes. It runs on shared GPUs on Hugging Face, which gives every visitor a few translations a day. If you hit the limit, come back tomorrow, or use the Space directly while signed in to Hugging Face for a bigger allowance.',
  },
  {
    question: 'Where do my claims go?',
    answer:
      "From your browser straight to the Hugging Face Space that runs the model. They never touch this server. Still, don't paste anything that isn't published yet.",
  },
  {
    question: 'Can I run it myself?',
    answer: 'Yes. The model is on Hugging Face under Apache 2.0, with code to run it.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<!-- What it does -->
<section class="py-16 md:py-24 bg-stone-50/70">
  <div class="max-w-5xl mx-auto px-6">
    <div class="max-w-2xl mb-12">
      <h2 class="text-2xl md:text-3xl font-bold text-stone-900 tracking-tight mb-4">
        What the Claim Translator does
      </h2>
      <p class="text-base text-stone-500 leading-relaxed">
        A general translator gives you Japanese claims in English. US counsel would restructure them before
        filing — different dependencies, US claim form, no reference numerals. This model was trained on what
        counsel actually filed, so it does that as it translates. Every example below is real output.
      </p>
    </div>

    <div class="space-y-4">
      {changes.map(({ name, summary, example }) => (
        <div class="p-6 md:p-7 rounded-2xl border border-stone-200 bg-white">
          <h3 class="text-lg font-bold text-stone-900 mb-3">{name}</h3>
          <p class="text-sm text-stone-500 leading-relaxed mb-4">{summary}</p>
          <div class="grid gap-3 md:grid-cols-2">
            <div class="rounded-lg bg-stone-50 border border-stone-100 p-4">
              <p class="text-xs text-stone-400 mb-1.5">Japanese</p>
              <p class="text-sm text-stone-600 leading-relaxed">{example.ja}</p>
            </div>
            <div class="rounded-lg bg-stone-50 border border-stone-100 p-4">
              <p class="text-xs text-stone-400 mb-1.5">English</p>
              <p class="text-sm text-stone-600 font-mono leading-relaxed" set:html={example.en} />
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="py-16 md:py-24">
  <div class="max-w-3xl mx-auto px-6">
    <h2 class="text-2xl md:text-3xl font-bold text-stone-900 tracking-tight mb-10">
      Claim Translator FAQ
    </h2>
    <div class="space-y-8">
      {faqs.map(({ question, answer }) => (
        <div>
          <h3 class="text-base font-semibold text-stone-900 mb-3">{question}</h3>
          <p class="text-sm text-stone-500 leading-relaxed">{answer}</p>
        </div>
      ))}
    </div>
    <p class="mt-10 text-sm text-stone-500">
      Model, training data and full results:
      <a href={MODEL_URL} class="font-medium text-amber-600 hover:text-amber-700" target="_blank" rel="noopener">
        qwen3-14b-jp-us-claims-lora on Hugging Face
      </a>
    </p>
  </div>
</section>

<!-- Workflow callout -->
<section class="py-16 md:py-20 bg-stone-50/70">
  <div class="max-w-3xl mx-auto px-6 text-center">
    <h2 class="text-2xl md:text-3xl font-bold text-stone-900 tracking-tight mb-4">
      Next: check the antecedent basis
    </h2>
    <p class="text-base text-stone-500 leading-relaxed mb-6 max-w-2xl mx-auto">
      Translation can leave a "the" in front of an element that was never introduced. Run the English claims
      through the Antecedent Basis checker before they go out.
    </p>
    <a
      href="/check-antecedent-basis"
      class="inline-flex items-center gap-2 text-sm font-medium text-amber-600 hover:text-amber-700 transition-colors"
    >
      Open Antecedent Basis
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    </a>
  </div>
</section>
