---
const features = [
  {
    label: "Structured viewing",
    title: "The full patent, structured for reading",
    description:
      "Abstract, description, claims, and figures — all in one continuous layout. Reference numerals are clickable throughout the text: click one to highlight every occurrence and see it on the figures. Figure references like \"FIG. 3\" jump to the drawing. Claim cross-references like \"the method of claim 1\" link back to the parent claim. Paragraph numbers are preserved so you can cite exactly where something appears.",
    details: [
      "Reference numerals are interactive — click to cross-highlight across the entire document",
      "Figure references (FIG. 1, FIG. 2A) jump directly to the drawing",
      "Claim cross-references link back to parent claims",
      "Paragraph numbers preserved for precise citation",
    ],
    icon: "layout",
  },
  {
    label: "Reference numerals",
    title: "Every reference numeral, extracted and indexed",
    description:
      "The reader extracts every reference numeral from the specification along with its description and how many times it appears. The sidebar gives you a browsable list — click any numeral to highlight it everywhere in the text and on the figures. Expand a numeral to see each occurrence with its surrounding context, so you can quickly understand how an element is used across the specification without scrolling through paragraphs.",
    details: [
      "Full list of numerals with descriptions and occurrence counts",
      "Click to cross-highlight in text, figures, and sidebar simultaneously",
      "Expand any numeral to browse each occurrence with surrounding context",
      "Filter and search within the reference numeral list",
    ],
    icon: "tag",
  },
  {
    label: "Figure bounding boxes",
    title: "Reference numerals overlaid on the drawings",
    description:
      "Reference numerals are detected on patent figures and drawn as clickable bounding boxes directly on the image. Select a numeral in the text and see it highlighted on the drawing. Or click a box on the figure to find that element in the specification. This is especially useful for mechanical and electrical patents where the relationship between the written description and the figures is critical to understanding the invention.",
    details: [
      "Clickable boxes drawn directly on patent figures",
      "Bidirectional linking — text to figure and figure to text",
      "Hover to preview the numeral's description without leaving the figure",
      "Works with multi-sheet figures and detailed drawings",
    ],
    icon: "scan",
  },
  {
    label: "Side-by-side comparison",
    title: "Compare two patents in a single view",
    description:
      "Load a second patent into a side-by-side panel. Each side has its own independent figures, reference numerals, search state, and scroll position. You can load a cited reference from the current patent's citation list, enter any patent number, or pick from another tab you already have open. This is the natural way to compare a cited reference against the patent under examination — the specification on one side, the prior art on the other.",
    details: [
      "Each panel has independent figures, search, and reference numeral state",
      "Load from citations list, by patent number, or from open tabs",
      "Scroll and navigate each side independently",
      "Ideal for comparing application claims against cited prior art",
    ],
    icon: "columns",
  },
  {
    label: "Multi-term search",
    title: "Search for multiple terms at once, each color-coded",
    description:
      "Add multiple search terms and each gets its own highlight color. Browse matches by section — see how many times each term appears in the abstract, description, and claims. Click any result to jump to that occurrence. Toggle case-sensitive or whole-word matching per term. This is useful when you're tracking how specific claim terms appear across a specification, or locating where a prior art reference discusses particular features.",
    details: [
      "Each term gets a distinct highlight color for easy visual scanning",
      "Match counts broken out by section (abstract, description, claims)",
      "Click any match to jump directly to it in the text",
      "Per-term toggles for case sensitivity and whole-word matching",
    ],
    icon: "search",
  },
];
---

<section class="py-20 md:py-28">
  <div class="max-w-6xl mx-auto px-6">
    <!-- Section header -->
    <div class="max-w-2xl mx-auto text-center mb-20">
      <p class="text-sm font-medium text-amber-600 tracking-wide uppercase mb-3">Features</p>
      <h2 class="text-3xl md:text-4xl font-bold text-stone-900 tracking-tight mb-4">
        Everything you need to read a patent
      </h2>
      <p class="text-lg text-stone-500 leading-relaxed">
        A structured viewer built for patent professionals. Free, no login required.
      </p>
    </div>

    <!-- Feature sections -->
    <div class="space-y-28 md:space-y-36">

      {features.map((feature, i) => (
        <div class:list={[
          "flex flex-col md:flex-row items-center gap-10 md:gap-16",
          i % 2 === 1 && "md:flex-row-reverse",
        ]}>
          {/* Text content */}
          <div class="flex-1 max-w-xl">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-9 h-9 rounded-lg bg-amber-100 flex items-center justify-center shrink-0">
                {feature.icon === "layout" && (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-amber-600"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
                )}
                {feature.icon === "tag" && (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-amber-600"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
                )}
                {feature.icon === "scan" && (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-amber-600"><path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/><circle cx="12" cy="12" r="3"/></svg>
                )}
                {feature.icon === "columns" && (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-amber-600"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M12 3v18"/></svg>
                )}
                {feature.icon === "search" && (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-amber-600"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                )}
              </div>
              <span class="text-xs font-medium text-amber-600 uppercase tracking-wide">{feature.label}</span>
            </div>

            <h3 class="text-2xl md:text-3xl font-bold text-stone-900 tracking-tight mb-4 leading-tight">
              {feature.title}
            </h3>
            <p class="text-base text-stone-500 leading-relaxed mb-6">
              {feature.description}
            </p>

            <ul class="space-y-3">
              {feature.details.map((detail) => (
                <li class="flex items-start gap-3 text-sm text-stone-600">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-amber-500 shrink-0 mt-0.5"><path d="M20 6 9 17l-5-5"/></svg>
                  {detail}
                </li>
              ))}
            </ul>
          </div>

          {/* Animated mock */}
          <div class="flex-1 w-full">

            {/* ── Mock 1: Structured Viewing ── */}
            {feature.icon === "layout" && (
              <div class="mock-frame">
                <div class="mock-chrome">
                  <div class="mock-dots"><div/><div/><div/></div>
                  <span class="mock-label">Patent Reader</span>
                </div>
                <div class="p-4 space-y-3">
                  <p class="mock-section-label">Abstract</p>
                  <p class="mock-text">
                    A method for detecting head location and orientation using a sensor array
                    <span class="sv-num">102</span> and processing unit <span class="sv-num">104</span>.
                    The system generates a depth map and applies machine learning models.
                  </p>

                  <p class="mock-section-label mt-1">Description</p>
                  <div class="flex gap-2">
                    <span class="mock-para-num">[0003]</span>
                    <p class="mock-text">
                      <span class="sv-fig">FIG. 1</span> illustrates an exemplary system
                      <span class="sv-num">100</span> for head tracking. The system
                      <span class="sv-num">100</span> includes a sensor array
                      <span class="sv-num">102</span> and a processing unit
                      <span class="sv-num">104</span> connected via a data bus
                      <span class="sv-num">106</span>.
                    </p>
                  </div>

                  <p class="mock-section-label mt-1">Claims</p>
                  <div class="flex gap-2">
                    <span class="mock-claim-num">1.</span>
                    <p class="mock-text">A method for detecting head location, the method comprising: receiving, by a processor, image data from a sensor array <span class="sv-num">102</span>; generating a depth map…</p>
                  </div>
                  <div class="flex gap-2">
                    <span class="mock-claim-num">2.</span>
                    <p class="mock-text">The method of <span class="sv-claim">claim 1</span>, wherein the sensor comprises a depth camera configured to capture infrared structured light patterns.</p>
                  </div>
                </div>
              </div>
            )}

            {/* ── Mock 2: Reference Numerals ── */}
            {feature.icon === "tag" && (
              <div class="mock-frame">
                <div class="mock-chrome">
                  <div class="mock-dots"><div/><div/><div/></div>
                  <span class="mock-label">Reference Numerals</span>
                </div>
                <div class="flex">
                  {/* Text panel */}
                  <div class="flex-1 p-4 border-r border-stone-100">
                    <p class="mock-section-label mb-2">Description</p>
                    <div class="space-y-2">
                      <div class="flex gap-2">
                        <span class="mock-para-num">[0003]</span>
                        <p class="mock-text">The system <span class="rn-num rn-100">100</span> includes a sensor array <span class="rn-num rn-102">102</span> and a processing unit <span class="rn-num rn-104">104</span>.</p>
                      </div>
                      <div class="flex gap-2">
                        <span class="mock-para-num">[0004]</span>
                        <p class="mock-text">The sensor array <span class="rn-num rn-102">102</span> captures depth data. The processing unit <span class="rn-num rn-104">104</span> receives data via bus <span class="rn-num rn-106">106</span>.</p>
                      </div>
                      <div class="flex gap-2">
                        <span class="mock-para-num">[0005]</span>
                        <p class="mock-text">A memory module <span class="rn-num rn-108">108</span> stores the depth map generated by the sensor <span class="rn-num rn-102">102</span>.</p>
                      </div>
                    </div>
                  </div>
                  {/* Sidebar */}
                  <div class="w-36 p-3 space-y-1">
                    <p class="text-[9px] font-semibold text-stone-400 uppercase tracking-wider mb-2">Numerals</p>
                    <div class="rn-row rn-row-100 flex items-center gap-2 px-2 py-1.5 rounded-md">
                      <span class="rn-badge">100</span>
                      <span class="text-[10px] text-stone-500 flex-1 truncate">system</span>
                      <span class="text-[9px] text-stone-300">×8</span>
                    </div>
                    <div class="rn-row rn-row-102 flex items-center gap-2 px-2 py-1.5 rounded-md">
                      <span class="rn-badge">102</span>
                      <span class="text-[10px] text-stone-500 flex-1 truncate">sensor</span>
                      <span class="text-[9px] text-stone-300">×6</span>
                    </div>
                    <div class="rn-row rn-row-104 flex items-center gap-2 px-2 py-1.5 rounded-md">
                      <span class="rn-badge">104</span>
                      <span class="text-[10px] text-stone-500 flex-1 truncate">processor</span>
                      <span class="text-[9px] text-stone-300">×4</span>
                    </div>
                    <div class="rn-row flex items-center gap-2 px-2 py-1.5 rounded-md">
                      <span class="rn-badge">106</span>
                      <span class="text-[10px] text-stone-500 flex-1 truncate">data bus</span>
                      <span class="text-[9px] text-stone-300">×3</span>
                    </div>
                    <div class="rn-row flex items-center gap-2 px-2 py-1.5 rounded-md">
                      <span class="rn-badge">108</span>
                      <span class="text-[10px] text-stone-500 flex-1 truncate">memory</span>
                      <span class="text-[9px] text-stone-300">×2</span>
                    </div>
                  </div>
                </div>
              </div>
            )}

            {/* ── Mock 4: Figure Bounding Boxes ── */}
            {feature.icon === "scan" && (
              <div class="mock-frame">
                <div class="mock-chrome">
                  <div class="mock-dots"><div/><div/><div/></div>
                  <span class="mock-label">FIG. 1</span>
                </div>
                <div class="p-5 relative">
                  {/* Block diagram — numerals only, no names */}
                  <div class="flex flex-col items-center gap-3">
                    {/* Top row */}
                    <div class="flex items-center gap-8 w-full justify-center">
                      <div class="fb-block relative px-6 py-4 border border-stone-300 rounded-lg bg-white text-center">
                        <span class="text-[11px] font-mono font-bold text-stone-400">102</span>
                        <div class="fb-box fb-box-102 absolute -inset-1 border-2 border-amber-400 rounded-xl pointer-events-none"></div>
                      </div>
                      <div class="w-10 border-t border-dashed border-stone-300"></div>
                      <div class="fb-block relative px-6 py-4 border border-stone-300 rounded-lg bg-white text-center">
                        <span class="text-[11px] font-mono font-bold text-stone-400">104</span>
                        <div class="fb-box fb-box-104 absolute -inset-1 border-2 border-amber-400 rounded-xl pointer-events-none"></div>
                      </div>
                    </div>
                    {/* Vertical connectors */}
                    <div class="flex gap-8 w-full justify-center">
                      <div class="w-20 flex justify-center"><div class="h-4 border-l border-dashed border-stone-300"></div></div>
                      <div class="w-10"></div>
                      <div class="w-20 flex justify-center"><div class="h-4 border-l border-dashed border-stone-300"></div></div>
                    </div>
                    {/* Bottom row */}
                    <div class="flex items-center gap-8 w-full justify-center">
                      <div class="fb-block relative px-6 py-4 border border-stone-300 rounded-lg bg-white text-center">
                        <span class="text-[11px] font-mono font-bold text-stone-400">108</span>
                      </div>
                      <div class="w-10 border-t border-dashed border-stone-300"></div>
                      <div class="fb-block relative px-6 py-4 border border-stone-300 rounded-lg bg-white text-center">
                        <span class="text-[11px] font-mono font-bold text-stone-400">106</span>
                      </div>
                    </div>
                  </div>
                  {/* Tooltip */}
                  <div class="mt-4 relative h-7 overflow-hidden">
                    <div class="fb-tip fb-tip-102 absolute inset-x-0 flex items-center gap-2 px-3 py-1.5 bg-stone-800 rounded-lg">
                      <span class="text-[10px] font-mono font-bold text-amber-300">102</span>
                      <span class="text-[10px] text-stone-300">— sensor array</span>
                      <span class="text-[9px] text-stone-500 ml-auto">6 occurrences</span>
                    </div>
                    <div class="fb-tip fb-tip-104 absolute inset-x-0 flex items-center gap-2 px-3 py-1.5 bg-stone-800 rounded-lg">
                      <span class="text-[10px] font-mono font-bold text-amber-300">104</span>
                      <span class="text-[10px] text-stone-300">— processing unit</span>
                      <span class="text-[9px] text-stone-500 ml-auto">4 occurrences</span>
                    </div>
                  </div>
                </div>
              </div>
            )}

            {/* ── Mock 5: Side-by-side ── */}
            {feature.icon === "columns" && (
              <div class="mock-frame">
                <div class="mock-chrome">
                  <div class="mock-dots"><div/><div/><div/></div>
                  <span class="mock-label">Side-by-Side</span>
                </div>
                <div class="flex overflow-hidden" style="min-height: 240px">
                  {/* Left panel */}
                  <div class="flex-1 p-3 border-r border-stone-100">
                    <div class="sbs-scroll-left">
                      <div class="flex items-center gap-2 mb-2">
                        <span class="text-[9px] font-mono font-bold text-stone-400 bg-stone-100 px-1.5 py-0.5 rounded">US11,423,567B2</span>
                      </div>
                      <p class="text-[10px] font-medium text-stone-700 mb-3">Methods and systems for detecting head location and orientation</p>
                      <p class="mock-section-label mb-1">Claims</p>
                      <div class="space-y-1.5">
                        <div class="flex gap-1.5">
                          <span class="mock-claim-num">1.</span>
                          <p class="mock-text">A method for detecting head location, the method comprising: receiving image data from a sensor array…</p>
                        </div>
                        <div class="flex gap-1.5">
                          <span class="mock-claim-num">2.</span>
                          <p class="mock-text">The method of claim 1, wherein the sensor comprises a depth camera…</p>
                        </div>
                        <div class="flex gap-1.5">
                          <span class="mock-claim-num">3.</span>
                          <p class="mock-text">The method of claim 1, further comprising calibrating the sensor…</p>
                        </div>
                      </div>
                    </div>
                  </div>
                  {/* Right panel — slides in */}
                  <div class="flex-1 p-3 sbs-panel-right">
                    <div class="sbs-scroll-right">
                      <div class="flex items-center gap-2 mb-2">
                        <span class="text-[9px] font-mono font-bold text-stone-400 bg-stone-100 px-1.5 py-0.5 rounded">US10,891,234B1</span>
                      </div>
                      <p class="text-[10px] font-medium text-stone-700 mb-3">Sensor-based spatial tracking with neural network processing</p>
                      <p class="mock-section-label mb-1">Description</p>
                      <div class="space-y-1.5">
                        <div class="flex gap-1.5">
                          <span class="mock-para-num">[0012]</span>
                          <p class="mock-text">The sensor array includes a plurality of infrared emitters positioned around the headset frame…</p>
                        </div>
                        <div class="flex gap-1.5">
                          <span class="mock-para-num">[0013]</span>
                          <p class="mock-text">A depth map is generated from the sensor data using a convolutional neural network…</p>
                        </div>
                        <div class="flex gap-1.5">
                          <span class="mock-para-num">[0014]</span>
                          <p class="mock-text">The orientation is computed as a quaternion representing rotation relative to a reference frame…</p>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            )}

            {/* ── Mock 6: Multi-term Search ── */}
            {feature.icon === "search" && (
              <div class="mock-frame">
                <div class="mock-chrome">
                  <div class="mock-dots"><div/><div/><div/></div>
                  <span class="mock-label">Search</span>
                </div>
                <div class="p-4">
                  {/* Search bar with chips */}
                  <div class="flex items-center gap-2 p-2 border border-stone-200 rounded-lg bg-stone-50/80 mb-4">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-stone-300 shrink-0"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                    <div class="flex gap-1.5 flex-wrap">
                      <span class="ms-chip ms-chip-1 px-2 py-0.5 text-[9px] font-medium rounded-full bg-blue-100 text-blue-700 whitespace-nowrap">sensor</span>
                      <span class="ms-chip ms-chip-2 px-2 py-0.5 text-[9px] font-medium rounded-full bg-emerald-100 text-emerald-700 whitespace-nowrap">depth map</span>
                      <span class="ms-chip ms-chip-3 px-2 py-0.5 text-[9px] font-medium rounded-full bg-pink-100 text-pink-700 whitespace-nowrap">processor</span>
                    </div>
                  </div>
                  {/* Text with highlights */}
                  <div class="space-y-2 mb-4">
                    <div class="flex gap-2">
                      <span class="mock-para-num">[0003]</span>
                      <p class="mock-text">The <span class="ms-hl ms-hl-1">sensor</span> array captures data and generates a <span class="ms-hl ms-hl-2">depth map</span> using the <span class="ms-hl ms-hl-3">processor</span>. Multiple <span class="ms-hl ms-hl-1">sensor</span> elements are arranged in a grid pattern.</p>
                    </div>
                    <div class="flex gap-2">
                      <span class="mock-para-num">[0004]</span>
                      <p class="mock-text">The <span class="ms-hl ms-hl-3">processor</span> computes orientation from the <span class="ms-hl ms-hl-2">depth map</span>. Each <span class="ms-hl ms-hl-1">sensor</span> reading is filtered before being passed to the <span class="ms-hl ms-hl-3">processor</span>.</p>
                    </div>
                  </div>
                  {/* Stats bar */}
                  <div class="flex items-center gap-5 pt-3 border-t border-stone-100">
                    <div class="flex items-center gap-1.5">
                      <div class="w-2 h-2 rounded-full bg-blue-400"></div>
                      <span class="text-[9px] text-stone-400">sensor <span class="font-medium text-stone-500">×14</span></span>
                    </div>
                    <div class="flex items-center gap-1.5">
                      <div class="w-2 h-2 rounded-full bg-emerald-400"></div>
                      <span class="text-[9px] text-stone-400">depth map <span class="font-medium text-stone-500">×8</span></span>
                    </div>
                    <div class="flex items-center gap-1.5">
                      <div class="w-2 h-2 rounded-full bg-pink-400"></div>
                      <span class="text-[9px] text-stone-400">processor <span class="font-medium text-stone-500">×6</span></span>
                    </div>
                  </div>
                </div>
              </div>
            )}

          </div>
        </div>
      ))}

    </div>

    <!-- CTA -->
    <div class="text-center mt-24">
      <a
        href="/patent-reader?patent=US11423567B2"
        class="inline-flex items-center gap-2 px-6 py-3 text-base font-medium text-white bg-amber-600 hover:bg-amber-700 rounded-lg transition-colors shadow-sm"
      >
        Try Patent Reader
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
      <p class="text-sm text-stone-400 mt-3">Free, no account required</p>
    </div>
  </div>
</section>

<style>
  /* ── Shared mock frame ── */
  .mock-frame {
    border-radius: 0.75rem;
    border: 1px solid rgb(231 229 228 / 0.8);
    background: white;
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.04), 0 4px 12px rgb(0 0 0 / 0.03);
    overflow: hidden;
  }
  .mock-chrome {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    background: rgb(250 250 249);
    border-bottom: 1px solid rgb(245 245 244);
  }
  .mock-dots {
    display: flex;
    gap: 0.3rem;
  }
  .mock-dots div {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: rgb(214 211 209);
  }
  .mock-label {
    font-size: 10px;
    font-weight: 500;
    color: rgb(168 162 158);
  }
  .mock-section-label {
    font-size: 9px;
    font-weight: 700;
    color: rgb(168 162 158);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .mock-text {
    font-size: 11px;
    line-height: 1.6;
    color: rgb(87 83 78);
  }
  .mock-para-num {
    font-size: 9px;
    font-family: ui-monospace, monospace;
    color: rgb(214 211 209);
    user-select: none;
    padding-top: 2px;
    flex-shrink: 0;
    width: 2rem;
    text-align: right;
  }
  .mock-claim-num {
    font-size: 10px;
    font-family: ui-monospace, monospace;
    font-weight: 500;
    color: rgb(168 162 158);
    flex-shrink: 0;
    width: 1rem;
    text-align: right;
    padding-top: 1px;
  }

  /* ───────────────────────────────────────
     Mock 1: Structured Viewing (9s cycle)
     Phase A (0-33%): reference numerals glow amber
     Phase B (33-66%): FIG reference glows blue
     Phase C (66-100%): claim ref glows violet
     ─────────────────────────────────────── */
  .sv-num {
    font-family: ui-monospace, monospace;
    font-size: 0.85em;
    padding: 0 3px;
    border-radius: 3px;
    color: rgb(146 64 14);
    transition: background 0.3s ease;
    animation: sv-num-pulse 9s ease infinite;
