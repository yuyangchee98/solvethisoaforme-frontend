---
const features = [
  {
    title: "Structured patent viewing",
    description: "See the full patent broken into sections — abstract, claims, description, and figures — with a clean reading layout instead of raw PDF.",
    icon: "layout",
  },
  {
    title: "Claim dependency trees",
    description: "Visualize how claims relate to each other. Independent and dependent claims shown in a collapsible tree with depth indicators.",
    icon: "git-branch",
  },
  {
    title: "Reference numeral mapping",
    description: "Every reference numeral extracted and linked to the figures where it appears. Click a numeral, see the figure. Click a figure, see its numerals.",
    icon: "tag",
  },
  {
    title: "Figure bounding boxes",
    description: "Reference numerals mapped to their locations on patent figures. Hover a numeral, see it highlighted on the drawing.",
    icon: "scan",
  },
  {
    title: "Side-by-side comparison",
    description: "Compare two patents side by side. Load a cited reference next to the original and review claims, descriptions, and figures in parallel.",
    icon: "columns",
  },
  {
    title: "Multi-term search",
    description: "Search for multiple terms simultaneously with distinct color coding. Find where key terms appear across claims and description.",
    icon: "search",
  },
];
---

<section class="py-20 md:py-28">
  <div class="max-w-6xl mx-auto px-6">
    <!-- Section header -->
    <div class="max-w-2xl mx-auto text-center mb-14">
      <p class="text-sm font-medium text-amber-600 tracking-wide uppercase mb-3">Features</p>
      <h2 class="text-3xl md:text-4xl font-bold text-stone-900 tracking-tight mb-4">
        Everything you need to read a patent
      </h2>
      <p class="text-lg text-stone-500 leading-relaxed">
        A structured viewer built for patent professionals. Free, no login required.
      </p>
    </div>

    <!-- Feature grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {features.map((feature) => (
        <div class="group p-6 rounded-xl border border-stone-100 bg-stone-50/50 hover:bg-white hover:border-stone-200 hover:shadow-md transition-all duration-200">
          <!-- Icon -->
          <div class="w-10 h-10 rounded-lg bg-amber-100 flex items-center justify-center mb-4">
            {feature.icon === "layout" && (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-amber-600"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>
            )}
            {feature.icon === "git-branch" && (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-amber-600"><line x1="6" y1="3" x2="6" y2="15"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M18 9a9 9 0 0 1-9 9"/></svg>
            )}
            {feature.icon === "tag" && (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-amber-600"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
            )}
            {feature.icon === "scan" && (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-amber-600"><path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/><circle cx="12" cy="12" r="3"/></svg>
            )}
            {feature.icon === "columns" && (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-amber-600"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M12 3v18"/></svg>
            )}
            {feature.icon === "search" && (
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-amber-600"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
            )}
          </div>

          <!-- Content -->
          <h3 class="text-base font-semibold text-stone-900 mb-2">{feature.title}</h3>
          <p class="text-sm text-stone-500 leading-relaxed">{feature.description}</p>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="text-center mt-10">
      <a
        href="/patent-reader"
        class="inline-flex items-center gap-2 px-6 py-3 text-base font-medium text-white bg-amber-600 hover:bg-amber-700 rounded-lg transition-colors shadow-sm"
      >
        Try Patent Reader
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
      <p class="text-sm text-stone-400 mt-3">Free, no account required</p>
    </div>
  </div>
</section>
