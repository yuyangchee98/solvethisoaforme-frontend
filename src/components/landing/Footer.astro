---
import { GITHUB_URL, GITHUB_URL_FRONTEND } from '../../siteConfig';
import { TOOLS } from '../../navigation';

const year = new Date().getFullYear();
---

<footer class="bg-stone-900 text-stone-400">
  <div class="max-w-6xl mx-auto px-6 py-14">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 mb-10">
      <!-- Brand -->
      <div>
        <p class="text-base font-semibold text-white mb-3">Solve This OA For Me</p>
        <p class="text-sm leading-relaxed max-w-xs">
          Open source, self-hosted patent prosecution tools. Run them on your own
          machine with your own Anthropic API key.
        </p>
      </div>

      <!-- Tools -->
      <div>
        <p class="text-sm font-semibold text-stone-300 uppercase tracking-wider mb-4">Tools</p>
        <ul class="space-y-2.5">
          {TOOLS.map(({ href, label }) => (
            <li><a href={href} class="text-sm hover:text-white transition-colors">{label}</a></li>
          ))}
          <li><a href="/blog" class="text-sm hover:text-white transition-colors">Blog</a></li>
          <li><a href={GITHUB_URL} class="text-sm hover:text-white transition-colors">Backend source</a></li>
          <li><a href={GITHUB_URL_FRONTEND} class="text-sm hover:text-white transition-colors">Frontend source</a></li>
        </ul>
      </div>

      <!-- Legal -->
      <div>
        <p class="text-sm font-semibold text-stone-300 uppercase tracking-wider mb-4">Legal</p>
        <ul class="space-y-2.5">
          <li><a href="/privacy.html" class="text-sm hover:text-white transition-colors">Privacy Policy</a></li>
          <li><a href="/terms.html" class="text-sm hover:text-white transition-colors">Terms of Service</a></li>
        </ul>
      </div>
    </div>

    <!-- Divider + copyright -->
    <div class="pt-6 border-t border-stone-800">
      <p class="text-xs text-stone-500">&copy; {year} Solve This OA For Me. All rights reserved.</p>
    </div>
  </div>
</footer>
