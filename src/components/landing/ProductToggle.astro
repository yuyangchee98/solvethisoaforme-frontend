---
---

<section class="py-8 md:py-12">
  <div class="max-w-3xl mx-auto px-6">
    <p class="text-sm font-medium text-stone-400 tracking-wide uppercase mb-4 text-center">Our Tools</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <!-- Patent Reader card -->
      <button
        data-product-toggle="patent-reader"
        onclick="switchProduct('patent-reader')"
        class="text-left p-5 rounded-xl border-2 border-stone-200 bg-white transition-all hover:border-emerald-400 cursor-pointer"
      >
        <div class="flex items-center gap-3 mb-2">
          <div class="w-9 h-9 rounded-lg bg-emerald-100 flex items-center justify-center">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-emerald-600"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          </div>
          <div>
            <h3 class="text-base font-semibold text-stone-900">Patent Reader</h3>
            <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium bg-emerald-100 text-emerald-700">Free</span>
          </div>
        </div>
        <p class="text-sm text-stone-500">Structured patent viewing, claim trees, reference numerals, and figure mapping.</p>
      </button>

      <!-- OA Agent card (default active) -->
      <button
        data-product-toggle="oa-agent"
        onclick="switchProduct('oa-agent')"
        class="text-left p-5 rounded-xl border-2 border-amber-500 bg-amber-50/50 transition-all hover:border-amber-400 cursor-pointer"
      >
        <div class="flex items-center gap-3 mb-2">
          <div class="w-9 h-9 rounded-lg bg-amber-100 flex items-center justify-center">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-amber-600"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          </div>
          <div>
            <h3 class="text-base font-semibold text-stone-900">OA Response Agent</h3>
            <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-medium bg-amber-100 text-amber-700">Paid</span>
          </div>
        </div>
        <p class="text-sm text-stone-500">AI reads your Office Action, cited prior art, and recommends argue/amend strategies.</p>
      </button>
    </div>
  </div>
</section>
