---
// CTA for a tool description page: opens the running app.
interface Props {
  /** Route of the running app, e.g. /patent-reader */
  appHref: string;
  /** Tool name, used in the "Open X" label */
  label: string;
  /** Optional size bump for hero placement */
  size?: 'md' | 'lg';
  /** Fine print shown next to the button */
  note?: string;
}

const { appHref, label, size = 'md', note = 'Free to use — nothing to install.' } = Astro.props;

const primary =
  size === 'lg'
    ? 'inline-flex items-center gap-2 px-6 py-3 text-base font-medium text-white bg-amber-600 hover:bg-amber-700 rounded-lg transition-colors shadow-sm'
    : 'inline-flex items-center gap-2 px-5 py-2.5 text-sm font-medium text-white bg-amber-600 hover:bg-amber-700 rounded-lg transition-colors shadow-sm';

const arrow = size === 'lg' ? 16 : 14;
---

<div class="flex flex-col sm:flex-row items-center gap-3">
  <a href={appHref} class={primary}>
    Open {label}
    <svg width={arrow} height={arrow} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
  </a>
  <span class="text-sm text-stone-400">{note}</span>
</div>
