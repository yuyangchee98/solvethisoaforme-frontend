---
const points = [
  {
    text: "Handle more cases without adding headcount",
    detail: "The reading, mapping, and cross-referencing that takes hours is done in minutes. Same attorney, more throughput.",
  },
  {
    text: "Respond faster than the competition",
    detail: "Faster turnaround on Office Actions means happier clients and more room to take on new work.",
  },
  {
    text: "Catch what gets missed under time pressure",
    detail: "The AI reads every cited passage in full. No skimming, no shortcuts, no missed arguments because you ran out of time.",
  },
];
---

<section class="py-20 md:py-28 bg-white">
  <div class="max-w-5xl mx-auto px-6">
    <div class="max-w-2xl mx-auto text-center mb-14">
      <h2 class="text-3xl md:text-4xl font-bold text-stone-900 tracking-tight mb-4">
        Your time is the bottleneck
      </h2>
      <p class="text-lg text-stone-500 leading-relaxed">
        Every Office Action follows the same pattern: hours of reading, mapping, and cross-referencing before you can start making decisions. That's time you're not spending on strategy, client calls, or the next case.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {points.map((point) => (
        <div class="p-6 rounded-xl border border-stone-100 bg-stone-50/50">
          <h3 class="text-base font-semibold text-stone-900 mb-2">{point.text}</h3>
          <p class="text-sm text-stone-500 leading-relaxed">{point.detail}</p>
        </div>
      ))}
    </div>
  </div>
</section>
