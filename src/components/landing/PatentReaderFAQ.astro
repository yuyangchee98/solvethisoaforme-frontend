---
const faqs = [
  {
    question: "Is Patent Reader really free?",
    answer: "Yes, completely free with no account required. Enter any patent number and get structured viewing, claim dependency trees, reference numeral mapping, figure bounding boxes, citation browsing, and side-by-side comparison. There are no usage limits or hidden paywalls.",
  },
  {
    question: "Where does Patent Reader get its data?",
    answer: "Patent data is fetched from Google Patents. This includes the full specification, claims, figures, citations, legal events, and family information. The reader structures this data into a more usable format with claim trees, reference numeral extraction, and figure mapping.",
  },
];
---

<section class="py-20 md:py-28 bg-white">
  <div class="max-w-3xl mx-auto px-6">
    <div class="text-center mb-14">
      <p class="text-sm font-medium text-amber-600 tracking-wide uppercase mb-3">FAQ</p>
      <h2 class="text-3xl md:text-4xl font-bold text-stone-900 tracking-tight mb-4">
        Patent Reader FAQ
      </h2>
    </div>

    <div class="space-y-6">
      {faqs.map((faq) => (
        <div class="p-6 bg-stone-50/50 rounded-xl border border-stone-100">
          <h3 class="text-base font-semibold text-stone-900 mb-3">{faq.question}</h3>
          <p class="text-sm text-stone-500 leading-relaxed">{faq.answer}</p>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="text-center mt-12">
      <a
        href="/patent-reader"
        class="inline-flex items-center gap-2 px-6 py-3 text-base font-medium text-white bg-amber-600 hover:bg-amber-700 rounded-lg transition-colors shadow-sm"
      >
        Try Patent Reader
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
      <p class="text-sm text-stone-400 mt-3">Free, no account required</p>
    </div>
  </div>
</section>
