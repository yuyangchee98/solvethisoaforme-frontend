---
const stats = [
  { value: "§101, §102, §103, §112", label: "All major rejection types handled" },
  { value: "~23 min", label: "Average time to first strategy draft" },
  { value: "PDF-native", label: "Upload docs directly — no reformatting" },
  { value: "100%", label: "Transparent — see every step the AI takes" },
];
---

<section class="py-12 border-y border-stone-100 bg-white">
  <div class="max-w-6xl mx-auto px-6">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-6">
      {stats.map((stat) => (
        <div class="text-center">
          <p class="text-lg md:text-xl font-bold text-stone-900 mb-1">{stat.value}</p>
          <p class="text-xs md:text-sm text-stone-500">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
