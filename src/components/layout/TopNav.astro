---
import { UserMenu } from '../auth/UserMenu';
import { MobileNavDropdown } from './MobileNavDropdown';
import { TOOLS, BLOG_POSTS } from '../../navigation';
const currentPath = Astro.url.pathname;

const pageLabels: Record<string, string> = {
  ...Object.fromEntries(TOOLS.map((t) => [t.appHref, t.label])),
  '/settings': 'Settings',
};
const currentPageLabel = pageLabels[currentPath];
---

<nav class="fixed top-0 left-0 right-0 h-16 bg-white/80 backdrop-blur-md border-b border-black/5 z-50">
  <div class="container mx-auto px-4 md:px-8 h-full flex items-center justify-between">
    <div class="flex items-center gap-4 md:gap-12">
      <!-- Logo with mega dropdown (desktop) -->
      <div class="group/nav relative flex items-center">
        <a href="/" class="flex items-center gap-2 whitespace-nowrap">
          <img src="/icon.svg" alt="Solve This OA For Me" class="h-9 w-9" />
          <span class="hidden md:inline-flex items-center gap-1.5 text-lg font-semibold text-stone-900">
            Solve This OA For Me
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-stone-400 group-hover/nav:text-stone-600 transition-colors mt-0.5"><path d="m6 9 6 6 6-6"/></svg>
          </span>
        </a>

        {currentPageLabel && (
          <span class="hidden md:inline-flex items-center gap-2 ml-3">
            <span class="text-stone-300">/</span>
            <span class="relative text-sm font-medium text-amber-600 pb-1">
              {currentPageLabel}
              <span class="absolute bottom-0 left-0 right-0 h-0.5 bg-amber-600 rounded-full"></span>
            </span>
          </span>
        )}

        <!-- Mega dropdown -->
        <div class="invisible opacity-0 group-hover/nav:visible group-hover/nav:opacity-100 transition-all duration-150 absolute top-full left-0 mt-1 w-[540px] bg-white rounded-xl border border-stone-200 shadow-xl p-5">
          <div class="grid grid-cols-2 gap-6">
            <!-- Left column: Tools -->
            <div>
              <p class="text-[11px] font-semibold text-stone-400 uppercase tracking-wider mb-2">Tools</p>
              <div class="space-y-1">
                {TOOLS.map(({ appHref, href, label, description }) => (
                  <a href={appHref} class={`block px-3 py-2 rounded-lg transition-colors ${currentPath === appHref ? 'bg-stone-50' : 'hover:bg-stone-50'}`}>
                    <p class={`text-sm font-medium ${currentPath === appHref ? 'text-amber-600' : 'text-stone-900'}`}>{label}</p>
                    <p class="text-xs text-stone-400">
                      {description} · <a href={href} class="hover:text-stone-600 underline underline-offset-2">about</a>
                    </p>
                  </a>
                ))}
              </div>
            </div>

            <!-- Right column: Blog -->
            <div>
              <div class="flex items-center justify-between mb-2">
                <p class="text-[11px] font-semibold text-stone-400 uppercase tracking-wider">Blog</p>
                <a href="/blog" class="text-[11px] font-medium text-amber-600 hover:text-amber-700 transition-colors">All posts →</a>
              </div>
              <div class="space-y-0.5">
                {BLOG_POSTS.map(({ href, label }) => (
                  <a href={href} class="block px-3 py-1.5 rounded-lg text-sm text-stone-600 hover:text-stone-900 hover:bg-stone-50 transition-colors leading-snug">
                    {label}
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>

      <MobileNavDropdown currentPath={currentPath} client:only="react" />
    </div>

    <div class="flex items-center gap-3">
      <div class="hidden md:block text-xs text-stone-500">
        <slot name="status" />
      </div>
      <UserMenu client:only="react" />
    </div>
  </div>
</nav>

<!-- Spacer for fixed nav -->
<div class="h-16"></div>
