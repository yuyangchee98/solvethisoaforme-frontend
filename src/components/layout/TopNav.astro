---
import { UserMenu } from '../auth/UserMenu';
import { MobileNavDropdown } from './MobileNavDropdown';
const currentPath = Astro.url.pathname;
---

<nav class="fixed top-0 left-0 right-0 h-16 bg-white/80 backdrop-blur-md border-b border-black/5 z-50">
  <div class="container mx-auto px-4 md:px-8 h-full flex items-center justify-between">
    <div class="flex items-center gap-4 md:gap-12">
      <a href="/oa-response" class="flex items-center gap-2 whitespace-nowrap">
        <img src="/icon.svg" alt="Solve This OA For Me" class="h-9 w-9" />
        <span class="hidden md:inline text-lg font-semibold text-stone-900">Solve This OA For Me</span>
      </a>

      <MobileNavDropdown currentPath={currentPath} client:only="react" />

      <div class="hidden md:flex items-center gap-8">
        <a
          href="/oa-response"
          class={`text-sm font-medium transition-colors relative pb-1 ${
            currentPath === '/oa-response' || currentPath === '/'
              ? 'text-amber-600'
              : 'text-stone-600 hover:text-stone-900'
          }`}
        >
          OA Response AI Agent
          {(currentPath === '/oa-response' || currentPath === '/') && (
            <span class="absolute bottom-0 left-0 right-0 h-0.5 bg-amber-600 rounded-full"></span>
          )}
        </a>

        <a
          href="/patent-reader"
          class={`text-sm font-medium transition-colors relative pb-1 ${
            currentPath === '/patent-reader'
              ? 'text-amber-600'
              : 'text-stone-600 hover:text-stone-900'
          }`}
        >
          Patent Reader
          {currentPath === '/patent-reader' && (
            <span class="absolute bottom-0 left-0 right-0 h-0.5 bg-amber-600 rounded-full"></span>
          )}
        </a>

        <!-- TODO: Re-add when antecedent basis feature is ready
        <a
          href="/check-antecedent-basis"
          class={`text-sm font-medium transition-colors relative pb-1 ${
            currentPath === '/check-antecedent-basis'
              ? 'text-amber-600'
              : 'text-stone-600 hover:text-stone-900'
          }`}
        >
          Check Antecedent Basis
          {currentPath === '/check-antecedent-basis' && (
            <span class="absolute bottom-0 left-0 right-0 h-0.5 bg-amber-600 rounded-full"></span>
          )}
        </a>
        -->
      </div>
    </div>

    <div class="flex items-center gap-3">
      <div class="hidden md:block text-xs text-stone-500">
        <slot name="status" />
      </div>
      <UserMenu client:only="react" />
    </div>
  </div>
</nav>

<!-- Spacer for fixed nav -->
<div class="h-16"></div>
