---
import { UserMenu } from '../auth/UserMenu';
import { MobileNavDropdown } from './MobileNavDropdown';
const currentPath = Astro.url.pathname;
---

<nav class="fixed top-0 left-0 right-0 h-16 bg-white/80 backdrop-blur-md border-b border-black/5 z-50">
  <div class="container mx-auto px-4 md:px-8 h-full flex items-center justify-between">
    <div class="flex items-center gap-4 md:gap-12">
      <!-- Logo with mega dropdown (desktop) -->
      <div class="group/nav relative">
        <a href="/" class="flex items-center gap-2 whitespace-nowrap">
          <img src="/icon.svg" alt="Solve This OA For Me" class="h-9 w-9" />
          <span class="hidden md:inline-flex items-center gap-1.5 text-lg font-semibold text-stone-900">
            Solve This OA For Me
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-stone-400 group-hover/nav:text-stone-600 transition-colors mt-0.5"><path d="m6 9 6 6 6-6"/></svg>
          </span>
        </a>

        <!-- Mega dropdown -->
        <div class="invisible opacity-0 group-hover/nav:visible group-hover/nav:opacity-100 transition-all duration-150 absolute top-full left-0 mt-1 w-[540px] bg-white rounded-xl border border-stone-200 shadow-xl p-5">
          <div class="grid grid-cols-2 gap-6">
            <!-- Left column: Products + Learn -->
            <div>
              <p class="text-[11px] font-semibold text-stone-400 uppercase tracking-wider mb-2">Tools</p>
              <div class="space-y-1 mb-5">
                <a href="/patent-reader" class="block px-3 py-2 rounded-lg hover:bg-stone-50 transition-colors">
                  <p class="text-sm font-medium text-stone-900">Patent Reader</p>
                  <p class="text-xs text-stone-400">Structured patent viewer</p>
                </a>
                <a href="/oa-response" class="block px-3 py-2 rounded-lg hover:bg-stone-50 transition-colors">
                  <p class="text-sm font-medium text-stone-900">OA Response Agent</p>
                  <p class="text-xs text-stone-400">AI Office Action analysis</p>
                </a>
              </div>

              <p class="text-[11px] font-semibold text-stone-400 uppercase tracking-wider mb-2">Learn</p>
              <div class="space-y-0.5">
                <a href="/" class="block px-3 py-1.5 rounded-lg text-sm text-stone-600 hover:text-stone-900 hover:bg-stone-50 transition-colors">Overview</a>
                <a href="/patent-reader/about" class="block px-3 py-1.5 rounded-lg text-sm text-stone-600 hover:text-stone-900 hover:bg-stone-50 transition-colors">About Patent Reader</a>
                <a href="/oa-response/about" class="block px-3 py-1.5 rounded-lg text-sm text-stone-600 hover:text-stone-900 hover:bg-stone-50 transition-colors">About OA Agent</a>
                <a href="/oa-response/about#pricing" class="block px-3 py-1.5 rounded-lg text-sm text-stone-600 hover:text-stone-900 hover:bg-stone-50 transition-colors">Pricing</a>
              </div>
            </div>

            <!-- Right column: Blog -->
            <div>
              <div class="flex items-center justify-between mb-2">
                <p class="text-[11px] font-semibold text-stone-400 uppercase tracking-wider">Blog</p>
                <a href="/blog" class="text-[11px] font-medium text-amber-600 hover:text-amber-700 transition-colors">All posts →</a>
              </div>
              <div class="space-y-0.5">
                <a href="/blog/best-ai-tools-for-responding-to-patent-office-actions" class="block px-3 py-1.5 rounded-lg text-sm text-stone-600 hover:text-stone-900 hover:bg-stone-50 transition-colors leading-snug">Best AI Tools for Patent OA Response</a>
                <a href="/blog/how-agentic-ai-reads-prior-art-differently-than-chatgpt" class="block px-3 py-1.5 rounded-lg text-sm text-stone-600 hover:text-stone-900 hover:bg-stone-50 transition-colors leading-snug">How Agentic AI Reads Prior Art</a>
                <a href="/blog/ai-for-patent-prosecution-what-works-and-what-doesnt" class="block px-3 py-1.5 rounded-lg text-sm text-stone-600 hover:text-stone-900 hover:bg-stone-50 transition-colors leading-snug">AI for Patent Prosecution: What Works</a>
                <a href="/blog/why-patent-attorneys-still-spend-hours-on-every-office-action" class="block px-3 py-1.5 rounded-lg text-sm text-stone-600 hover:text-stone-900 hover:bg-stone-50 transition-colors leading-snug">Why OAs Still Take 6 Hours</a>
                <a href="/blog/antecedent-basis-mistakes-examiners-catch-that-ai-catches-first" class="block px-3 py-1.5 rounded-lg text-sm text-stone-600 hover:text-stone-900 hover:bg-stone-50 transition-colors leading-snug">Antecedent Basis Mistakes AI Catches</a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <MobileNavDropdown currentPath={currentPath} client:only="react" />

      <div class="hidden md:flex items-center gap-8">
        <a
          href="/oa-response"
          class={`text-sm font-medium transition-colors relative pb-1 ${
            currentPath === '/oa-response' || currentPath === '/'
              ? 'text-amber-600'
              : 'text-stone-600 hover:text-stone-900'
          }`}
        >
          OA Response AI Agent
          {(currentPath === '/oa-response' || currentPath === '/') && (
            <span class="absolute bottom-0 left-0 right-0 h-0.5 bg-amber-600 rounded-full"></span>
          )}
        </a>

        <a
          href="/patent-reader"
          class={`text-sm font-medium transition-colors relative pb-1 ${
            currentPath === '/patent-reader'
              ? 'text-amber-600'
              : 'text-stone-600 hover:text-stone-900'
          }`}
        >
          Patent Reader
          {currentPath === '/patent-reader' && (
            <span class="absolute bottom-0 left-0 right-0 h-0.5 bg-amber-600 rounded-full"></span>
          )}
        </a>
      </div>
    </div>

    <div class="flex items-center gap-3">
      <div class="hidden md:block text-xs text-stone-500">
        <slot name="status" />
      </div>
      <UserMenu client:only="react" />
    </div>
  </div>
</nav>

<!-- Spacer for fixed nav -->
<div class="h-16"></div>
