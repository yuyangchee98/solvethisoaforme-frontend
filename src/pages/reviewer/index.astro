---
import Layout from '../../layouts/Layout.astro';
import TopNav from '../../components/layout/TopNav.astro';
import { Reviewer } from '../../components/reviewer/Reviewer';
---

<Layout title="Reviewer" noindex>
  <TopNav />
  <main class="h-[calc(100vh-64px)] overflow-hidden bg-stone-50">
    <Reviewer modeId="strategy-vs-prior-art" client:only="react" />
  </main>
</Layout>

<style is:global>
  /* Citation flash highlight — applied briefly when scroll-to-anchor
     lands on a target in the Source pane. */
  @keyframes reviewer-flash-kf {
    0% {
      background-color: rgb(254 243 199); /* amber-100 */
      box-shadow: 0 0 0 4px rgb(254 243 199);
    }
    100% {
      background-color: transparent;
      box-shadow: 0 0 0 0 transparent;
    }
  }
  .reviewer-flash {
    animation: reviewer-flash-kf 1.5s ease-out;
    border-radius: 4px;
  }
</style>
