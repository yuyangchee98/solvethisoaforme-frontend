                      <div class="flex items-center gap-1.5 text-[10px] font-semibold uppercase tracking-wider text-stone-400 mb-1.5">
                        <span class="w-2.5 h-2.5 rounded-full shrink-0 bg-green-300"></span>
                        depth <span class="font-normal">(8)</span>
                      </div>
                      <div class="border border-stone-200 rounded-md overflow-hidden">
                        <div class="px-3 py-1.5 flex gap-2 items-start border-b border-stone-100">
                          <span class="text-[9px] text-amber-600 font-medium shrink-0 mt-0.5 w-16">Abstract</span>
                          <span class="text-[10px] text-stone-500 leading-snug">...generates a <mark class="bg-green-200/70 rounded-sm px-0.5">depth</mark> map and applies...</span>
                        </div>
                        <div class="px-3 py-1.5 flex gap-2 items-start">
                          <span class="text-[9px] text-amber-600 font-medium shrink-0 mt-0.5 w-16">Claim 2</span>
                          <span class="text-[10px] text-stone-500 leading-snug">...comprises a <mark class="bg-green-200/70 rounded-sm px-0.5">depth</mark> camera configured...</span>
