    <script>
      function initMockAnimation() {
        const mock = document.getElementById('patent-mock');
        const cursor = document.getElementById('mock-cursor');
        const content = document.getElementById('mock-content');
        if (!mock || !cursor || !content) return;

        const refSpans = mock.querySelectorAll('.mock-ref[data-ref="100"]');
        const sidebarRow = document.getElementById('sidebar-ref-100');
        const searchInput = document.getElementById('search-input');
        const searchSubmit = document.getElementById('search-submit');
        const searchInputWrap = document.getElementById('search-input-wrap');
        const searchChip1 = document.getElementById('search-chip-1');
        const searchChip2 = document.getElementById('search-chip-2');
        const searchHits1 = document.getElementById('search-hits-1');
        const searchHits2 = document.getElementById('search-hits-2');
        const searchHls = mock.querySelectorAll('.mock-search-hl');
        const depthHls = mock.querySelectorAll('.mock-depth-hl');
        const detailsRow102 = document.getElementById('details-row-102');
        const detailsChevron102 = document.getElementById('details-chevron-102');
        const detailsExpand102 = document.getElementById('details-expand-102');

        const tabs = {
          figures: document.getElementById('tab-figures'),
          details: document.getElementById('tab-details'),
          outline: document.getElementById('tab-outline'),
          search: document.getElementById('tab-search'),
        };
        const panels = {
          figures: document.getElementById('panel-figures'),
          details: document.getElementById('panel-details'),
          outline: document.getElementById('panel-outline'),
          search: document.getElementById('panel-search'),
        };

        const ACTIVE_TAB = 'text-[11px] pb-2 border-b-2 transition-all duration-300 font-semibold text-stone-800 border-amber-500';
        const INACTIVE_TAB = 'text-[11px] pb-2 border-b-2 transition-all duration-300 font-medium text-stone-400 border-transparent';
        const TRANSITION = 'left 0.8s cubic-bezier(0.4,0,0.2,1), top 0.8s cubic-bezier(0.4,0,0.2,1), opacity 0.4s ease, transform 0.1s ease';

        let isAnimating = false;
        let visible = false;

        const delay = (ms) => new Promise(r => setTimeout(r, ms));

        function setTab(active) {
          for (const [name, tab] of Object.entries(tabs)) {
            if (tab) tab.className = name === active ? ACTIVE_TAB : INACTIVE_TAB;
          }
          for (const [name, panel] of Object.entries(panels)) {
            if (!panel) continue;
            panel.style.opacity = name === active ? '1' : '0';
            panel.style.pointerEvents = name === active ? '' : 'none';
          }
        }

        function resetState() {
          cursor.style.transition = 'none';
          cursor.style.opacity = '0';
          cursor.style.left = (mock.offsetWidth * 0.25) + 'px';
          cursor.style.top = (mock.offsetHeight * 0.5) + 'px';
          cursor.style.transform = '';
          cursor.offsetHeight;
          cursor.style.transition = TRANSITION;

          refSpans.forEach(el => { el.style.backgroundColor = ''; el.style.color = ''; });
          if (sidebarRow) sidebarRow.style.backgroundColor = '';
          content.scrollTop = 0;
          setTab('figures');

          // Reset search state
          if (searchInput) searchInput.value = '';
          [searchChip1, searchChip2, searchHits1, searchHits2].forEach(el => { if (el) el.style.opacity = '0'; });
          if (searchSubmit) { searchSubmit.style.color = ''; searchSubmit.style.borderColor = ''; }
          if (searchInputWrap) { searchInputWrap.style.borderColor = ''; searchInputWrap.style.boxShadow = ''; }
          searchHls.forEach(el => el.classList.remove('active'));
          depthHls.forEach(el => el.classList.remove('active'));

          // Reset details expansion
          if (detailsChevron102) detailsChevron102.style.transform = '';
          if (detailsExpand102) { detailsExpand102.style.maxHeight = '0'; detailsExpand102.style.opacity = '0'; detailsExpand102.style.paddingTop = '0'; detailsExpand102.style.paddingBottom = '0'; }
          if (detailsRow102) detailsRow102.style.backgroundColor = '';
        }

        function moveCursorTo(el) {
          const mr = mock.getBoundingClientRect();
          const er = el.getBoundingClientRect();
          cursor.style.left = (er.left - mr.left + er.width / 2) + 'px';
          cursor.style.top = (er.top - mr.top + er.height / 2) + 'px';
        }

        async function clickEffect() {
          cursor.style.transform = 'scale(0.8)';
          await delay(100);
          cursor.style.transform = '';
        }

        async function clickTab(tabName) {
          const tab = tabs[tabName];
          if (!tab) return false;
          moveCursorTo(tab);
          await delay(700);
          if (!visible) return false;
          await clickEffect();
          setTab(tabName);
          return true;
        }

        async function repositionCursor(x, y) {
          cursor.style.transition = 'none';
          cursor.style.left = (mock.offsetWidth * x) + 'px';
          cursor.style.top = (mock.offsetHeight * y) + 'px';
          cursor.offsetHeight;
          cursor.style.transition = TRANSITION;
        }

        function applyHover(el, bg, color) {
          el.style.backgroundColor = bg;
          if (color) el.style.color = color;
        }
        function clearHover(el) {
          el.style.backgroundColor = '';
          el.style.color = '';
        }

        async function typeText(input, text) {
          for (let i = 0; i < text.length; i++) {
            input.value = text.slice(0, i + 1);
            await delay(80 + Math.random() * 60);
          }
        }

        async function playAnimation() {
          if (isAnimating) return;
          isAnimating = true;
          resetState();

          // === Phase 1: Scroll the spec ===
          await delay(800);
          if (!visible) { isAnimating = false; return; }
          content.scrollTo({ top: 180, behavior: 'smooth' });
          await delay(2000);
          if (!visible) { isAnimating = false; return; }
          content.scrollTo({ top: 0, behavior: 'smooth' });
          await delay(1200);
          if (!visible) { isAnimating = false; return; }

          // === Phase 2: Demo interactive element types ===
          cursor.style.opacity = '1';
          await delay(300);

          // 2a: Hover a reference numeral → cross-highlight ALL 102s + sidebar + figure bbox
          const refs102 = mock.querySelectorAll('.mock-ref-102');
          const sidebarRef102 = document.getElementById('sidebar-ref-102');
          const bbox102 = document.getElementById('bbox-102');
          const firstRef102 = refs102[0];
          if (firstRef102) {
            moveCursorTo(firstRef102);
            await delay(800);
            // Cross-highlight all 102 instances + sidebar row + figure bounding box
            refs102.forEach(el => { el.style.backgroundColor = 'rgb(253 230 138 / 0.7)'; el.style.color = 'rgb(120 53 15)'; });
            if (sidebarRef102) sidebarRef102.style.backgroundColor = 'rgb(255 251 235)';
            if (bbox102) { bbox102.style.fill = 'rgba(245,158,11,0.3)'; bbox102.style.stroke = 'rgba(245,158,11,1)'; bbox102.style.strokeWidth = '1.5'; }
            await delay(1500);
            // Clear on "mouse leave"
            refs102.forEach(el => { el.style.backgroundColor = ''; el.style.color = ''; });
            if (sidebarRef102) sidebarRef102.style.backgroundColor = '';
            if (bbox102) { bbox102.style.fill = ''; bbox102.style.stroke = ''; bbox102.style.strokeWidth = ''; }
            await delay(300);
          }

          // 2b: Hover "FIG. 1" → blue highlight
          const figRef = content.querySelector('.text-blue-600');
          if (figRef) {
            moveCursorTo(figRef);
            await delay(700);
            applyHover(figRef, 'rgb(239 246 255)', 'rgb(30 64 175)');
            await delay(800);
            clearHover(figRef);
            await delay(200);
          }
          if (!visible) { isAnimating = false; return; }

          // 2c: Click "100" → cross-highlights across text + sidebar
          if (refSpans.length > 0) {
            moveCursorTo(refSpans[0]);
            await delay(700);
            if (!visible) { isAnimating = false; return; }
            await clickEffect();
            refSpans.forEach(el => {
              el.style.backgroundColor = 'rgb(253 230 138 / 0.7)';
              el.style.color = 'rgb(120 53 15)';
            });
            if (sidebarRow) sidebarRow.style.backgroundColor = 'rgb(255 251 235)';
          }

          await delay(2000);
          if (!visible) { isAnimating = false; return; }

          // 2d: Scroll down to show "claim 1" link, hover it → violet
          content.scrollTo({ top: 300, behavior: 'smooth' });
          await delay(1200);
          refSpans.forEach(el => { el.style.backgroundColor = ''; el.style.color = ''; });
          if (sidebarRow) sidebarRow.style.backgroundColor = '';

          const claimRef = content.querySelector('.text-violet-600');
          if (claimRef) {
            moveCursorTo(claimRef);
            await delay(700);
            applyHover(claimRef, 'rgb(245 243 255)', 'rgb(91 33 182)');
            await delay(800);
            clearHover(claimRef);
          }
          if (!visible) { isAnimating = false; return; }

          // Scroll back up
          content.scrollTo({ top: 0, behavior: 'smooth' });
          cursor.style.opacity = '0';
          await delay(1000);
          if (!visible) { isAnimating = false; return; }

          // === Phase 3: Details — click row to expand ===
          await repositionCursor(0.6, 0.1);
          cursor.style.opacity = '1';
          await delay(200);

          if (!(await clickTab('details'))) { isAnimating = false; return; }
          await delay(1000);
          if (!visible) { isAnimating = false; return; }

          // Click 102 row to expand it
          if (detailsRow102) {
            moveCursorTo(detailsRow102);
            await delay(700);
            await clickEffect();
            detailsRow102.style.backgroundColor = 'rgb(254 243 199 / 0.7)';
            if (detailsChevron102) detailsChevron102.style.transform = 'rotate(90deg)';
            if (detailsExpand102) {
              detailsExpand102.style.maxHeight = '120px';
              detailsExpand102.style.opacity = '1';
              detailsExpand102.style.paddingTop = '';
              detailsExpand102.style.paddingBottom = '';
            }
          }

          await delay(2200);
          if (!visible) { isAnimating = false; return; }

          // === Phase 4: Outline ===
          if (!(await clickTab('outline'))) { isAnimating = false; return; }
          await delay(2000);
          if (!visible) { isAnimating = false; return; }

          // === Phase 5: Search — type two terms ===
          if (!(await clickTab('search'))) { isAnimating = false; return; }
          await delay(500);
          if (!visible) { isAnimating = false; return; }

          if (searchInput) {
            // --- Term 1: "sensor" ---
            moveCursorTo(searchInput);
            await delay(600);
            await clickEffect();
            if (searchInputWrap) {
              searchInputWrap.style.borderColor = 'rgb(245 158 11)';
              searchInputWrap.style.boxShadow = '0 0 0 2px rgb(245 158 11 / 0.3)';
            }
            await delay(200);
            await typeText(searchInput, 'sensor');
            await delay(300);
            if (searchSubmit) { searchSubmit.style.color = 'rgb(68 64 60)'; searchSubmit.style.borderColor = 'rgb(168 162 158)'; }
            moveCursorTo(searchSubmit);
            await delay(500);
            await clickEffect();
            if (searchInputWrap) { searchInputWrap.style.borderColor = ''; searchInputWrap.style.boxShadow = ''; }
            searchInput.value = '';

            // Show sensor chip + hits + text highlights
            if (searchChip1) searchChip1.style.opacity = '1';
            if (searchHits1) searchHits1.style.opacity = '1';
            searchHls.forEach(el => el.classList.add('active'));

            await delay(1500);
            if (!visible) { isAnimating = false; return; }

            // --- Term 2: "depth" ---
            moveCursorTo(searchInput);
            await delay(500);
            await clickEffect();
            if (searchInputWrap) {
              searchInputWrap.style.borderColor = 'rgb(245 158 11)';
              searchInputWrap.style.boxShadow = '0 0 0 2px rgb(245 158 11 / 0.3)';
            }
            await delay(200);
            await typeText(searchInput, 'depth');
            await delay(300);
            if (searchSubmit) { searchSubmit.style.color = 'rgb(68 64 60)'; searchSubmit.style.borderColor = 'rgb(168 162 158)'; }
            moveCursorTo(searchSubmit);
            await delay(500);
            await clickEffect();
            if (searchInputWrap) { searchInputWrap.style.borderColor = ''; searchInputWrap.style.boxShadow = ''; }
            searchInput.value = '';

            // Show depth chip + hits + text highlights (green)
            if (searchChip2) searchChip2.style.opacity = '1';
            if (searchHits2) searchHits2.style.opacity = '1';
            depthHls.forEach(el => el.classList.add('active'));

            await delay(2500);
            if (!visible) { isAnimating = false; return; }
          }

          // === Phase 6: Back to Figures, clean up ===
          if (!(await clickTab('figures'))) { isAnimating = false; return; }
          searchHls.forEach(el => el.classList.remove('active'));
          depthHls.forEach(el => el.classList.remove('active'));
          [searchChip1, searchChip2, searchHits1, searchHits2].forEach(el => { if (el) el.style.opacity = '0'; });
          if (searchSubmit) { searchSubmit.style.color = ''; searchSubmit.style.borderColor = ''; }
          if (detailsRow102) detailsRow102.style.backgroundColor = '';
          if (detailsChevron102) detailsChevron102.style.transform = '';
          if (detailsExpand102) { detailsExpand102.style.maxHeight = '0'; detailsExpand102.style.opacity = '0'; }
          await delay(800);

          cursor.style.opacity = '0';
          await delay(3000);

          isAnimating = false;
          if (visible) playAnimation();
        }

        const observer = new IntersectionObserver((entries) => {
          visible = entries[0].isIntersecting;
          if (visible && !isAnimating) playAnimation();
        }, { threshold: 0.3 });

        observer.observe(mock);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initMockAnimation);
      } else {
        initMockAnimation();
      }
    </script>

