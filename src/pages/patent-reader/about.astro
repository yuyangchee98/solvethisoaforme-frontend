---
import LandingLayout from '../../layouts/LandingLayout.astro';
import LandingNav from '../../components/landing/LandingNav.astro';
import PatentReaderFeatures from '../../components/landing/PatentReaderFeatures.astro';
import PatentReaderHowItWorks from '../../components/landing/PatentReaderHowItWorks.astro';
import PatentReaderFAQ from '../../components/landing/PatentReaderFAQ.astro';
import Footer from '../../components/landing/Footer.astro';

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Is Patent Reader really free?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Yes, completely free with no account required. Enter any patent number and get structured viewing, claim dependency trees, reference numeral mapping, figure bounding boxes, citation browsing, and side-by-side comparison. No hidden paywalls.",
      },
    },
    {
      "@type": "Question",
      name: "How is this different from Google Patents?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Google Patents shows you the raw document. Patent Reader structures it for prosecution work — claim dependency trees, clickable reference numerals cross-linked to figures, bounding boxes overlaid on drawings, and multi-term color-coded search. It's the viewer you wish Google Patents had.",
      },
    },
    {
      "@type": "Question",
      name: "Where does Patent Reader get its data?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Patent data is sourced from official patent office publications. You get the full specification, claims, figures, citations, legal events, and family information — structured into claim trees, reference numeral extraction, and figure mapping.",
      },
    },
    {
      "@type": "Question",
      name: "What patent offices are supported?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "US (USPTO), European (EPO), Chinese (CNIPA), Japanese (JPO), Korean (KIPO), PCT (WIPO), and many more. Enter the publication number in any standard format.",
      },
    },
    {
      "@type": "Question",
      name: "Can I use Patent Reader during prosecution?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Absolutely. Patent Reader is designed for patent professionals. Use it to quickly understand a cited reference, compare two patents side by side, or check how claim elements map to figures. It pairs naturally with the OA Response Agent — read the prior art in Patent Reader, then analyze the rejection with the agent.",
      },
    },
  ],
};

const supportedOffices = [
  { code: "US", name: "United States Patent and Trademark Office (USPTO)" },
  { code: "EP", name: "European Patent Office (EPO)" },
  { code: "WO", name: "World Intellectual Property Organization (WIPO/PCT)" },
  { code: "CN", name: "China National Intellectual Property Administration (CNIPA)" },
  { code: "JP", name: "Japan Patent Office (JPO)" },
  { code: "KR", name: "Korean Intellectual Property Office (KIPO)" },
  { code: "CA", name: "Canadian Intellectual Property Office (CIPO)" },
  { code: "AU", name: "IP Australia" },
  { code: "IN", name: "Indian Patent Office (IPO)" },
  { code: "GB", name: "UK Intellectual Property Office (UKIPO)" },
  { code: "DE", name: "German Patent and Trade Mark Office (DPMA)" },
  { code: "FR", name: "French National Institute of Industrial Property (INPI)" },
];
---

<LandingLayout
  title="Patent Reader - Free Structured Patent Viewer"
  description="Free patent viewer with claim dependency trees, reference numeral mapping, figure bounding boxes, side-by-side comparison, and multi-term search. No account required."
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <LandingNav />
  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-amber-50/60 via-transparent to-transparent pointer-events-none"></div>
      <div class="relative max-w-4xl mx-auto px-6 pt-20 pb-20 md:pt-28 md:pb-28 text-center">
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-amber-100 text-amber-700 mb-6">
          Free — no account required
        </span>
        <h1 class="text-4xl md:text-5xl font-bold text-stone-900 tracking-tight leading-[1.1] mb-6">
          A better way to
          <span class="text-amber-600"> read patents</span>
        </h1>
        <p class="text-lg text-stone-500 leading-relaxed mb-10 max-w-2xl mx-auto">
          Enter a patent number like you would on Google Patents — but get claim dependency trees, reference numeral mapping, figure bounding boxes, and side-by-side comparison.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="/patent-reader"
            class="inline-flex items-center gap-2 px-6 py-3 text-base font-medium text-white bg-amber-600 hover:bg-amber-700 rounded-lg transition-colors shadow-sm"
          >
            Try on a real patent
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <span class="inline-flex items-center gap-1.5 text-sm text-stone-400">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="animate-bounce"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg>
            Scroll to learn more
          </span>
        </div>
      </div>
    </section>

    <style>
      #mock-content::-webkit-scrollbar { display: none; }
      .mock-search-hl { background-color: transparent; color: inherit; transition: background-color 0.4s ease; }
      .mock-search-hl.active { background-color: rgb(253 224 71 / 0.7); }
      .mock-depth-hl { background-color: transparent; color: inherit; transition: background-color 0.4s ease; }
      .mock-depth-hl.active { background-color: rgb(134 239 172 / 0.7); }
      #bbox-102 { transition: fill 0.3s ease, stroke 0.3s ease, stroke-width 0.3s ease; }
    </style>

    <!-- Product mock -->
    <section class="pb-16 md:pb-20">
      <div class="max-w-5xl mx-auto px-6">
        <div id="patent-mock" class="relative rounded-xl border border-stone-200/80 bg-white shadow-lg overflow-hidden">
          <!-- Ghost cursor for animation -->
          <div id="mock-cursor" class="absolute z-50 pointer-events-none" style="opacity: 0; filter: drop-shadow(0 1px 2px rgba(0,0,0,0.15)); transform-origin: 3px 1px;">
            <svg width="20" height="20" viewBox="0 0 24 24"><path d="M4 1l14 10.5-6.5 1.5L8 20z" fill="white" stroke="#1c1917" stroke-width="1.5" stroke-linejoin="round"/></svg>
          </div>
          <!-- App chrome bar -->
          <div class="flex items-center justify-between px-4 py-2.5 bg-stone-50 border-b border-stone-100">
            <div class="flex items-center gap-3">
              <div class="flex gap-1.5">
                <div class="w-2.5 h-2.5 rounded-full bg-stone-200"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-stone-200"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-stone-200"></div>
              </div>
              <span class="text-[11px] font-medium text-stone-400">Patent Reader</span>
            </div>
            <div class="px-2 py-0.5 rounded bg-stone-100 text-[10px] text-stone-400 font-medium">US11423567B2</div>
          </div>

          <!-- Patent title bar -->
          <div class="px-4 py-2 border-b border-stone-100 bg-white">
            <p class="text-[12px] font-medium text-stone-700 truncate">Methods and systems for detecting head location and orientation using sensor data</p>
          </div>

          <!-- 2-panel layout -->
          <div class="flex" style="min-height: 400px;">
            <!-- Main content: Title → Abstract → Description → Claims -->
            <div id="mock-content" class="flex-1 p-4 relative border-r border-stone-100 bg-stone-50/50" style="overflow-y: auto; scrollbar-width: none; -ms-overflow-style: none;">
              <!-- Abstract -->
              <p class="text-[11px] font-semibold text-stone-400 uppercase tracking-wider mb-2">Abstract</p>
              <p class="text-[11px] text-stone-700 leading-relaxed mb-4">A method for detecting head location and orientation using a <mark class="mock-search-hl rounded-sm px-0.5">sensor</mark> array <span class="font-mono text-[0.8em] text-stone-400 hover:bg-amber-100/50 hover:text-amber-700 rounded px-0.5 mock-ref-102 transition-all duration-300">102</span> and processing unit <span class="font-mono text-[0.8em] text-stone-400 hover:bg-amber-100/50 hover:text-amber-700 rounded px-0.5">104</span>. The system generates a <mark class="mock-depth-hl rounded-sm px-0.5">depth</mark> map and applies machine learning models to determine position and orientation in real time.</p>

              <!-- Description -->
              <p class="text-[11px] font-semibold text-stone-400 uppercase tracking-wider mb-2">Description</p>
              <div class="space-y-3 text-[11px] text-stone-700 leading-relaxed mb-4">
                <div class="flex gap-2">
                  <span class="text-[10px] font-mono text-stone-300 select-none pt-1 shrink-0 w-10 text-right">[0001]</span>
                  <p>The present invention relates to methods and systems for detecting head location and orientation using sensor data.</p>
                </div>
                <div class="flex gap-2">
                  <span class="text-[10px] font-mono text-stone-300 select-none pt-1 shrink-0 w-10 text-right">[0002]</span>
                  <p>In various applications, such as virtual reality, augmented reality, and human-computer interaction, it is desirable to accurately track the position and orientation of a user's head.</p>
                </div>
                <div class="flex gap-2">
                  <span class="text-[10px] font-mono text-stone-300 select-none pt-1 shrink-0 w-10 text-right">[0003]</span>
                  <p><span class="text-blue-600 font-medium">FIG. 1</span> illustrates an exemplary system <span class="font-mono text-[0.8em] text-stone-400 rounded px-0.5 mock-ref transition-all duration-300" data-ref="100">100</span> for head tracking. The system <span class="font-mono text-[0.8em] text-stone-400 rounded px-0.5 mock-ref transition-all duration-300" data-ref="100">100</span> includes a <mark class="mock-search-hl rounded-sm px-0.5">sensor</mark> array <span class="font-mono text-[0.8em] text-stone-400 hover:bg-amber-100/50 hover:text-amber-700 rounded px-0.5 mock-ref-102 transition-all duration-300">102</span> and a processing unit <span class="font-mono text-[0.8em] text-stone-400 hover:bg-amber-100/50 hover:text-amber-700 rounded px-0.5">104</span> connected via a data bus <span class="font-mono text-[0.8em] text-stone-400 hover:bg-amber-100/50 hover:text-amber-700 rounded px-0.5">106</span>.</p>
                </div>
                <div class="flex gap-2">
                  <span class="text-[10px] font-mono text-stone-300 select-none pt-1 shrink-0 w-10 text-right">[0004]</span>
                  <p>The <mark class="mock-search-hl rounded-sm px-0.5">sensor</mark> array <span class="font-mono text-[0.8em] text-stone-400 hover:bg-amber-100/50 hover:text-amber-700 rounded px-0.5 mock-ref-102 transition-all duration-300">102</span> comprises one or more <mark class="mock-depth-hl rounded-sm px-0.5">depth</mark> <mark class="mock-search-hl rounded-sm px-0.5">sensor</mark>s configured to capture three-dimensional point cloud data of a scene. In one embodiment, the sensor array <span class="font-mono text-[0.8em] text-stone-400 hover:bg-amber-100/50 hover:text-amber-700 rounded px-0.5 mock-ref-102 transition-all duration-300">102</span> includes a structured-light depth camera operating at a frame rate of at least 30 Hz.</p>
                </div>
                <div class="flex gap-2">
                  <span class="text-[10px] font-mono text-stone-300 select-none pt-1 shrink-0 w-10 text-right">[0005]</span>
                  <p>The processing unit <span class="font-mono text-[0.8em] text-stone-400 hover:bg-amber-100/50 hover:text-amber-700 rounded px-0.5">104</span> receives the point cloud data via the data bus <span class="font-mono text-[0.8em] text-stone-400 hover:bg-amber-100/50 hover:text-amber-700 rounded px-0.5">106</span> and generates a <mark class="mock-depth-hl rounded-sm px-0.5">depth</mark> map representing the spatial distribution of surfaces in the captured scene. The depth map is stored in a frame buffer for subsequent processing.</p>
                </div>
                <div class="flex gap-2">
                  <span class="text-[10px] font-mono text-stone-300 select-none pt-1 shrink-0 w-10 text-right">[0006]</span>
                  <p><span class="text-blue-600 font-medium">FIG. 2</span> illustrates a convolutional neural network architecture used by the processing unit <span class="font-mono text-[0.8em] text-stone-400 hover:bg-amber-100/50 hover:text-amber-700 rounded px-0.5">104</span> to determine head position and orientation. The network receives the depth map as input and outputs a six-degree-of-freedom pose estimate comprising three translational and three rotational components.</p>
                </div>
                <div class="flex gap-2">
                  <span class="text-[10px] font-mono text-stone-300 select-none pt-1 shrink-0 w-10 text-right">[0007]</span>
                  <p>Prior to inference, the system performs a calibration procedure in which the sensor array <span class="font-mono text-[0.8em] text-stone-400 hover:bg-amber-100/50 hover:text-amber-700 rounded px-0.5 mock-ref-102 transition-all duration-300">102</span> captures a series of reference frames under controlled lighting conditions. These reference frames are used to compute intrinsic and extrinsic camera parameters stored in a calibration table.</p>
                </div>
              </div>

              <!-- Claims -->
              <p class="text-[11px] font-semibold text-stone-400 uppercase tracking-wider mb-2">Claims</p>
              <div class="space-y-3">
                <div class="flex items-start gap-2">
                  <span class="text-[10px] font-mono font-medium text-stone-400 shrink-0 w-5 text-right pt-0.5 select-none">1.</span>
                  <p class="text-[11px] text-stone-700 leading-relaxed">A method for detecting head location and orientation, the method comprising: receiving, by a processor, image data from a sensor array <span class="font-mono text-[0.8em] text-stone-400 hover:bg-amber-100/50 hover:text-amber-700 rounded px-0.5 mock-ref-102 transition-all duration-300">102</span>; generating a depth map...</p>
                </div>
                <div class="flex items-start gap-2">
                  <span class="text-[10px] font-mono font-medium text-stone-400 shrink-0 w-5 text-right pt-0.5 select-none">2.</span>
                  <p class="text-[11px] text-stone-700 leading-relaxed">The method of <span class="text-violet-600 font-medium">claim 1</span>, wherein the sensor comprises a depth camera configured to capture infrared structured light patterns.</p>
                </div>
                <div class="flex items-start gap-2">
                  <span class="text-[10px] font-mono font-medium text-stone-400 shrink-0 w-5 text-right pt-0.5 select-none">3.</span>
                  <p class="text-[11px] text-stone-700 leading-relaxed">The method of <span class="text-violet-600 font-medium">claim 1</span>, further comprising calibrating the sensor based on ambient lighting conditions.</p>
                </div>
              </div>
              <div class="absolute bottom-0 left-0 right-0 h-10 bg-gradient-to-t from-stone-50/50 to-transparent pointer-events-none"></div>
            </div>

            <!-- Right sidebar (w-72) -->
            <div class="w-72 shrink-0 flex flex-col overflow-hidden relative">
              <!-- Sidebar tab bar -->
              <div class="flex items-center gap-4 px-4 pt-3 pb-0 border-b border-stone-100">
                <button id="tab-figures" class="text-[11px] pb-2 border-b-2 transition-all duration-300 font-semibold text-stone-800 border-amber-500">Figures</button>
                <button id="tab-details" class="text-[11px] pb-2 border-b-2 transition-all duration-300 font-medium text-stone-400 border-transparent">Details</button>
                <button id="tab-outline" class="text-[11px] pb-2 border-b-2 transition-all duration-300 font-medium text-stone-400 border-transparent">Outline</button>
                <button id="tab-search" class="text-[11px] pb-2 border-b-2 transition-all duration-300 font-medium text-stone-400 border-transparent">Search</button>
              </div>

              <div class="relative p-4">
                <!-- Figures panel -->
                <div id="panel-figures" class="space-y-3 transition-opacity duration-300">
                  <!-- Bounding boxes toggle -->
                  <div class="flex items-center justify-end">
                    <div class="flex items-center gap-1.5 text-[10px] px-2 py-1 rounded-md bg-amber-100 text-amber-700">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/><circle cx="12" cy="12" r="3"/></svg>
                      Bounding boxes
                    </div>
                  </div>

                  <!-- Figure with block diagram + bbox overlays -->
                  <div class="rounded-lg bg-white border border-stone-200 p-3 relative">
                    <svg viewBox="0 0 240 160" class="w-full" xmlns="http://www.w3.org/2000/svg">
                      <!-- System 100 outer box -->
                      <rect x="10" y="10" width="220" height="130" rx="3" fill="none" stroke="#78716c" stroke-width="1" stroke-dasharray="4 2"/>
                      <text x="20" y="26" font-size="8" font-family="monospace" fill="#78716c">100</text>

                      <!-- Sensor Array 102 -->
                      <rect x="25" y="45" width="80" height="50" rx="2" fill="none" stroke="#292524" stroke-width="1.2"/>
                      <text x="65" y="68" font-size="8" text-anchor="middle" font-family="system-ui" fill="#292524">Sensor Array</text>
                      <text x="65" y="82" font-size="8" text-anchor="middle" font-family="monospace" fill="#78716c">102</text>

                      <!-- Processing Unit 104 -->
                      <rect x="140" y="45" width="80" height="50" rx="2" fill="none" stroke="#292524" stroke-width="1.2"/>
                      <text x="180" y="68" font-size="8" text-anchor="middle" font-family="system-ui" fill="#292524">Processing Unit</text>
                      <text x="180" y="82" font-size="8" text-anchor="middle" font-family="monospace" fill="#78716c">104</text>

                      <!-- Data Bus 106 connecting them -->
                      <line x1="105" y1="70" x2="140" y2="70" stroke="#292524" stroke-width="1.2"/>
                      <polygon points="137,67 140,70 137,73" fill="#292524"/>
                      <text x="122" y="64" font-size="7" text-anchor="middle" font-family="monospace" fill="#78716c">106</text>

                      <!-- Bounding box overlays (amber for numerals, sky for fig label) -->
                      <rect x="12" y="17" width="22" height="14" rx="1" fill="rgba(245,158,11,0.15)" stroke="rgba(245,158,11,0.6)" stroke-width="0.8"/>
                      <rect id="bbox-102" x="52" y="74" width="26" height="14" rx="1" fill="rgba(245,158,11,0.15)" stroke="rgba(245,158,11,0.6)" stroke-width="0.8" style="transition: fill 0.3s, stroke 0.3s;"/>
                      <rect x="167" y="74" width="26" height="14" rx="1" fill="rgba(245,158,11,0.15)" stroke="rgba(245,158,11,0.6)" stroke-width="0.8"/>
                      <rect x="112" y="56" width="20" height="12" rx="1" fill="rgba(245,158,11,0.15)" stroke="rgba(245,158,11,0.6)" stroke-width="0.8"/>
                      <!-- FIG. 1 label bbox (sky blue) -->
                      <rect x="98" y="146" width="44" height="14" rx="1" fill="rgba(56,189,248,0.15)" stroke="rgba(56,189,248,0.6)" stroke-width="0.8"/>

                      <!-- FIG. 1 label -->
                      <text x="120" y="155" font-size="9" text-anchor="middle" font-family="system-ui" font-weight="500" fill="#57534e">FIG. 1</text>
                    </svg>
                  </div>

                  <!-- Elements on this sheet -->
                  <div>
                    <p class="text-[10px] font-medium text-stone-400 uppercase tracking-wide mb-2">Elements on sheet</p>
                    <div class="space-y-1">
                      <div id="sidebar-ref-100" class="flex items-center gap-2 p-1 rounded hover:bg-stone-50 transition-colors duration-300">
                        <span class="text-[10px] font-mono font-bold text-amber-700 bg-amber-100/70 px-1.5 py-0.5 rounded">100</span>
                        <span class="text-[10px] text-stone-500">head tracking system</span>
                      </div>
                      <div id="sidebar-ref-102" class="flex items-center gap-2 p-1 rounded hover:bg-stone-50 transition-colors duration-300">
                        <span class="text-[10px] font-mono font-bold text-amber-700 bg-amber-100/70 px-1.5 py-0.5 rounded">102</span>
                        <span class="text-[10px] text-stone-500">sensor array</span>
                      </div>
                      <div class="flex items-center gap-2 p-1 rounded hover:bg-stone-50">
                        <span class="text-[10px] font-mono font-bold text-amber-700 bg-amber-100/70 px-1.5 py-0.5 rounded">104</span>
                        <span class="text-[10px] text-stone-500">processing unit</span>
                      </div>
                      <div class="flex items-center gap-2 p-1 rounded hover:bg-stone-50">
                        <span class="text-[10px] font-mono font-bold text-amber-700 bg-amber-100/70 px-1.5 py-0.5 rounded">106</span>
                        <span class="text-[10px] text-stone-500">data bus</span>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Outline panel (hidden initially) -->
                <div id="panel-outline" class="absolute inset-0 p-4 transition-opacity duration-300 opacity-0 pointer-events-none">
                  <!-- Sections -->
                  <p class="text-[11px] font-semibold text-stone-400 uppercase tracking-wider mb-2">Sections</p>
                  <div class="space-y-0.5 mb-4">
                    <div class="text-[11px] text-stone-600 p-1 rounded hover:bg-stone-50 cursor-pointer">Abstract</div>
                    <div class="text-[11px] text-stone-600 p-1 rounded hover:bg-stone-50 cursor-pointer">Description</div>
                    <div class="text-[11px] text-stone-400 p-1 rounded hover:bg-stone-50 cursor-pointer pl-4">Brief Description of Drawings</div>
                    <div class="text-[11px] text-stone-400 p-1 rounded hover:bg-stone-50 cursor-pointer pl-4">Detailed Description</div>
                    <div class="text-[11px] text-stone-600 p-1 rounded hover:bg-stone-50 cursor-pointer">Claims</div>
                  </div>

                  <!-- Claim Tree -->
                  <p class="text-[11px] font-semibold text-stone-400 uppercase tracking-wider mb-2">Claims</p>
                  <div class="space-y-0.5">
                    <div class="flex items-center gap-1.5 p-1 rounded bg-amber-50/60">
                      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-stone-300 shrink-0"><path d="m6 9 6 6 6-6"/></svg>
                      <span class="text-[10px] font-mono font-bold text-amber-700">1.</span>
                      <span class="text-[10px] text-stone-600 font-medium truncate">A method for detecting head location...</span>
                      <span class="text-[9px] text-stone-400 bg-stone-100 px-1 rounded shrink-0">+3</span>
                    </div>
                    <div class="flex items-center gap-1.5 p-1 rounded pl-6">
                      <span class="text-[10px] font-mono text-stone-400">2.</span>
                      <span class="text-[10px] text-stone-500 truncate">...wherein the sensor comprises a depth camera</span>
                    </div>
                    <div class="flex items-center gap-1.5 p-1 rounded pl-6">
                      <span class="text-[10px] font-mono text-stone-400">3.</span>
                      <span class="text-[10px] text-stone-500 truncate">...further comprising calibrating the sensor</span>
                    </div>
                    <div class="flex items-center gap-1.5 p-1 rounded pl-6">
                      <span class="text-[10px] font-mono text-stone-400">4.</span>
                      <span class="text-[10px] text-stone-500 truncate">...applying a convolutional neural network</span>
                    </div>
                    <div class="flex items-center gap-1.5 p-1 rounded bg-amber-50/60 mt-1">
                      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-stone-300 shrink-0"><path d="m6 9 6 6 6-6"/></svg>
                      <span class="text-[10px] font-mono font-bold text-amber-700">5.</span>
                      <span class="text-[10px] text-stone-600 font-medium truncate">A system comprising a sensor array...</span>
                      <span class="text-[9px] text-stone-400 bg-stone-100 px-1 rounded shrink-0">+1</span>
                    </div>
                    <div class="flex items-center gap-1.5 p-1 rounded pl-6">
                      <span class="text-[10px] font-mono text-stone-400">6.</span>
                      <span class="text-[10px] text-stone-500 truncate">...wherein the processor is configured to</span>
                    </div>
                  </div>
                </div>

                <!-- Details panel (hidden initially) -->
                <div id="panel-details" class="absolute inset-0 p-3 transition-opacity duration-300 opacity-0 pointer-events-none overflow-hidden">
                  <!-- Reference Numerals -->
