---
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingNav from '../components/landing/LandingNav.astro';
import PatentReaderMock from '../components/landing/PatentReaderMock.astro';
import Footer from '../components/landing/Footer.astro';

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Solve This OA For Me",
  url: "https://solvethisoaforme.chyuang.com",
  logo: "https://solvethisoaforme.chyuang.com/favicon.ico",
  applicationCategory: "BusinessApplication",
  description:
    "Free patent prosecution tools in the browser. A structured patent viewer, an AI agent that reads the cited prior art and recommends argue or amend, and an antecedent basis checker for amended claims. The agent runs on your own Anthropic API key.",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};
---

<LandingLayout
  title="Patent Tools for Prosecution | Solve This OA For Me"
  description="Free tools for answering Office Actions: a structured patent viewer, an AI agent that reads the cited prior art on your own Anthropic API key, and an antecedent basis checker for amended claims."
>
  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  <LandingNav />
  <main>
    <!-- Product cards -->
    <section class="pt-20 pb-12 md:pt-28 md:pb-16">
      <div class="max-w-5xl mx-auto px-6">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <!-- Patent Reader -->
          <a href="/patent-reader" class="group block p-6 rounded-xl border border-stone-200 bg-white hover:border-amber-300 hover:shadow-lg transition-all">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-lg bg-amber-100 flex items-center justify-center shrink-0">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-amber-600"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
              </div>
              <h2 class="text-xl font-bold text-stone-900">Patent Reader</h2>
            </div>
            <p class="text-sm text-stone-500 leading-relaxed mb-6">
              A structured patent viewer built for patent professionals. Enter any patent number and get claim dependency trees, reference numeral mapping, figure bounding boxes, and multi-term search.
            </p>
            <span class="inline-flex items-center gap-1 text-sm font-medium text-amber-600 group-hover:text-amber-700 transition-colors">
              Open tool
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </span>
          </a>

          <!-- OA Agent -->
          <a href="/oa-agent" class="group block p-6 rounded-xl border border-stone-200 bg-white hover:border-amber-300 hover:shadow-lg transition-all">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-lg bg-amber-100 flex items-center justify-center shrink-0">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-amber-600"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              </div>
              <h2 class="text-xl font-bold text-stone-900">OA Agent</h2>
            </div>
            <p class="text-sm text-stone-500 leading-relaxed mb-6">
              Upload your Office Action and let AI analyze every rejection, read the cited prior art, and recommend argue-or-amend strategies. Every conclusion cites a specific passage you can verify yourself.
            </p>
            <span class="inline-flex items-center gap-1 text-sm font-medium text-amber-600 group-hover:text-amber-700 transition-colors">
              Open tool
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </span>
          </a>

          <!-- Antecedent Basis Checker -->
          <a href="/check-antecedent-basis" class="group block p-6 rounded-xl border border-stone-200 bg-white hover:border-amber-300 hover:shadow-lg transition-all">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-lg bg-amber-100 flex items-center justify-center shrink-0">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-amber-600"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/><path d="M9 14l2 2 4-4"/></svg>
              </div>
              <h2 class="text-xl font-bold text-stone-900">Antecedent Basis</h2>
            </div>
            <p class="text-sm text-stone-500 leading-relaxed mb-6">
              Paste a claim set and check for missing antecedent basis, ambiguous pronouns, unclear "such" phrases, prepositional scope, and silent reintroduction before you file.
            </p>
            <span class="inline-flex items-center gap-1 text-sm font-medium text-amber-600 group-hover:text-amber-700 transition-colors">
              Open tool
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </span>
          </a>
        </div>
      </div>
    </section>

    <!-- About -->
    <section class="py-16 md:py-24 bg-stone-50/70">
      <div class="max-w-3xl mx-auto px-6">
        <h2 class="text-2xl md:text-3xl font-bold text-stone-900 tracking-tight mb-4">
          Patent tools built for patent work
        </h2>
        <div class="space-y-4 text-base text-stone-500 leading-relaxed">
          <p>
            Most patent tools are built by software companies that treat patents like any other document. The result is generic viewers, generic AI, and workflows that don't match how prosecution actually works.
          </p>
          <p>
            Solve This OA For Me is built specifically for patent prosecution. The patent viewer understands claim dependencies, reference numerals, and figure annotations. The OA agent reads the actual cited prior art, follows the examiner's specific paragraph and column citations, and maps claim elements to references — the same mechanical work you do before you can start thinking about strategy.
          </p>
        </div>
      </div>
    </section>

    <!-- Patent Reader detail -->
    <section class="py-16 md:py-24">
      <div class="max-w-5xl mx-auto px-6">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-10 h-10 rounded-lg bg-amber-100 flex items-center justify-center">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-amber-600"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          </div>
          <div>
            <h2 class="text-2xl md:text-3xl font-bold text-stone-900 tracking-tight">Patent Reader</h2>
          </div>
        </div>
        <p class="text-base text-stone-500 leading-relaxed mb-8 max-w-2xl">
          Enter a patent number like you would on Google Patents — but get claim dependency trees, reference numeral mapping, figure bounding boxes, and multi-term search. Free, no account required.
        </p>

        <!-- Bento grid -->
        <div class="grid grid-cols-1 md:grid-cols-6 gap-3">
          <!-- Claim trees — wide -->
          <div class="md:col-span-4 p-6 rounded-2xl border border-stone-150 bg-stone-50/80">
            <div class="w-9 h-9 rounded-lg bg-amber-100/80 flex items-center justify-center mb-3">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-amber-600"><line x1="6" y1="3" x2="6" y2="15"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M18 9a9 9 0 0 1-9 9"/></svg>
            </div>
            <h3 class="text-sm font-semibold text-stone-900 mb-1">Claim dependency trees</h3>
            <p class="text-sm text-stone-500 leading-relaxed">Independent and dependent claims in a collapsible tree. See which claims depend on which at a glance, click any node to jump to the claim text.</p>
          </div>

          <!-- Reference numerals — tall -->
          <div class="md:col-span-2 md:row-span-2 p-6 rounded-2xl border border-stone-150 bg-stone-50/80 flex flex-col">
            <div class="w-9 h-9 rounded-lg bg-amber-100/80 flex items-center justify-center mb-3">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-amber-600"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
            </div>
            <h3 class="text-sm font-semibold text-stone-900 mb-1">Reference numeral mapping</h3>
            <p class="text-sm text-stone-500 leading-relaxed">Every reference numeral extracted with its description and occurrence count. Click any numeral to cross-highlight it in the text, figures, and sidebar — or expand it to browse each occurrence with surrounding context.</p>
          </div>

          <!-- Figure bounding boxes -->
          <div class="md:col-span-2 p-6 rounded-2xl border border-stone-150 bg-stone-50/80">
            <div class="w-9 h-9 rounded-lg bg-amber-100/80 flex items-center justify-center mb-3">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-amber-600"><path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/><circle cx="12" cy="12" r="3"/></svg>
            </div>
            <h3 class="text-sm font-semibold text-stone-900 mb-1">Figure bounding boxes</h3>
            <p class="text-sm text-stone-500 leading-relaxed">Reference numerals overlaid on patent figures as clickable boxes. Select a numeral in the text and see it on the drawing.</p>
          </div>

          <!-- Search — wide -->
          <div class="md:col-span-3 p-6 rounded-2xl border border-stone-150 bg-stone-50/80">
            <div class="w-9 h-9 rounded-lg bg-amber-100/80 flex items-center justify-center mb-3">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-amber-600"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
            </div>
            <h3 class="text-sm font-semibold text-stone-900 mb-1">Multi-term search</h3>
            <p class="text-sm text-stone-500 leading-relaxed">Search for multiple terms at once, each color-coded. Browse occurrences by section with case-sensitive and whole-word matching.</p>
          </div>

          <!-- Any patent -->
          <div class="md:col-span-3 p-6 rounded-2xl border border-stone-150 bg-stone-50/80">
            <div class="w-9 h-9 rounded-lg bg-amber-100/80 flex items-center justify-center mb-3">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-amber-600"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            </div>
            <h3 class="text-sm font-semibold text-stone-900 mb-1">Any patent number</h3>
            <p class="text-sm text-stone-500 leading-relaxed">US, EP, CN, JP, KR, PCT, and more. Paste a patent or publication number and get the full document instantly.</p>
          </div>
        </div>

        <div class="mt-8 flex items-center gap-3">
          <a
            href="/patent-reader?patent=US11423567B2"
            class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-medium text-white bg-amber-600 hover:bg-amber-700 rounded-lg transition-colors shadow-sm"
          >
            Try on a real patent
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>

        <div class="mt-12">
          <PatentReaderMock />
        </div>
      </div>
    </section>

    <!-- OA Agent detail -->
    <section class="py-16 md:py-24 bg-stone-50/70">
      <div class="max-w-5xl mx-auto px-6">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-10 h-10 rounded-lg bg-amber-100 flex items-center justify-center">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-amber-600"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          </div>
          <h2 class="text-2xl md:text-3xl font-bold text-stone-900 tracking-tight">OA Agent</h2>
        </div>
        <p class="text-base text-stone-500 leading-relaxed mb-8 max-w-2xl">
          Upload your Office Action and your application. The AI reads the cited prior art, maps each claim limitation to the examiner's cited evidence, and recommends whether to argue or amend.
        </p>

        <!-- Bento grid -->
        <div class="grid grid-cols-1 md:grid-cols-6 gap-3">
          <!-- Reads prior art — wide -->
          <div class="md:col-span-3 p-6 rounded-2xl border border-stone-200 bg-white">
            <div class="w-9 h-9 rounded-lg bg-amber-100/80 flex items-center justify-center mb-3">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-amber-600"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
            </div>
            <h3 class="text-sm font-semibold text-stone-900 mb-1">Reads the actual prior art</h3>
            <p class="text-sm text-stone-500 leading-relaxed">Follows the examiner's specific paragraph and column citations to the relevant passages. Checks whether they actually teach what the examiner says.</p>
          </div>

          <!-- Maps elements — wide -->
          <div class="md:col-span-3 p-6 rounded-2xl border border-stone-200 bg-white">
            <div class="w-9 h-9 rounded-lg bg-amber-100/80 flex items-center justify-center mb-3">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-amber-600"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            </div>
            <h3 class="text-sm font-semibold text-stone-900 mb-1">Maps claim elements to references</h3>
            <p class="text-sm text-stone-500 leading-relaxed">For every rejection, maps each claim limitation to the passage the examiner relies on. For combinations, shows which element comes from which reference.</p>
          </div>

          <!-- Argue/amend — tall -->
          <div class="md:col-span-2 md:row-span-2 p-6 rounded-2xl border border-stone-200 bg-white flex flex-col">
            <div class="w-9 h-9 rounded-lg bg-amber-100/80 flex items-center justify-center mb-3">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-amber-600"><path d="m16 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1z"/><path d="m2 16 3-8 3 8c-.87.65-1.92 1-3 1s-2.13-.35-3-1z"/><path d="M7 21h10"/><path d="M12 3v18"/><path d="M3 7h2c2 0 5-1 7-2 2 1 5 2 7 2h2"/></svg>
            </div>
            <h3 class="text-sm font-semibold text-stone-900 mb-1">Argue or amend recommendations</h3>
            <p class="text-sm text-stone-500 leading-relaxed">Looks for arguments first. Suggests amendments only when arguing alone isn't enough. You get draft argument language and suggested claim amendments with spec support.</p>
          </div>

          <!-- Every step visible -->
          <div class="md:col-span-4 p-6 rounded-2xl border border-stone-200 bg-white">
            <div class="w-9 h-9 rounded-lg bg-amber-100/80 flex items-center justify-center mb-3">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-amber-600"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>
            </div>
            <h3 class="text-sm font-semibold text-stone-900 mb-1">Every step is visible</h3>
            <p class="text-sm text-stone-500 leading-relaxed">See which document is being read, which passage is being analyzed, which conclusion is being drawn. Click any citation to jump to the source and check it yourself.</p>
          </div>

          <!-- All rejection types -->
          <div class="md:col-span-4 p-6 rounded-2xl border border-stone-200 bg-white">
            <div class="w-9 h-9 rounded-lg bg-amber-100/80 flex items-center justify-center mb-3">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-amber-600"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/><path d="M9 14l2 2 4-4"/></svg>
            </div>
            <h3 class="text-sm font-semibold text-stone-900 mb-1">All rejection types</h3>
            <p class="text-sm text-stone-500 leading-relaxed">Novelty, obviousness, subject matter eligibility, written description, definiteness — and their equivalents at the EPO, CNIPA, JPO, KIPO, and PCT.</p>
          </div>

          <!-- Conversational -->
          <div class="md:col-span-6 p-6 rounded-2xl border border-stone-200 bg-white">
            <div class="w-9 h-9 rounded-lg bg-amber-100/80 flex items-center justify-center mb-3">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-amber-600"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            </div>
            <h3 class="text-sm font-semibold text-stone-900 mb-1">Conversational</h3>
            <p class="text-sm text-stone-500 leading-relaxed">Ask follow-ups. Drill into a specific rejection. Ask it to check a particular passage or draft an argument for a specific limitation. Use it like a research assistant.</p>
          </div>
        </div>

        <!-- Intro video -->
        <div class="mt-12">
          <div class="relative rounded-2xl overflow-hidden shadow-xl border border-stone-200/60 bg-black">
            <video
              controls
              preload="metadata"
              poster="/intro-video-poster.jpg"
              class="w-full aspect-video"
            >
              <source src="/intro-video.mp4" type="video/mp4" />
            </video>
          </div>
          <p class="text-center text-sm text-stone-400 mt-4">
            The OA Agent in 40 seconds
          </p>
        </div>

        <div class="mt-8 flex items-center gap-3">
          <a
            href="/oa-agent"
            class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-medium text-white bg-amber-600 hover:bg-amber-700 rounded-lg transition-colors shadow-sm"
          >
            Try now
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Free + BYOK (replaces the old Pricing section) -->
    <section class="py-12 md:py-16">
      <div class="max-w-3xl mx-auto px-6">
        <div class="p-7 md:p-8 rounded-2xl border border-amber-200 bg-amber-50/60">
          <h2 class="text-lg font-bold text-stone-900 mb-3">
            Free to use
          </h2>
          <p class="text-sm text-stone-600 leading-relaxed">
            All three tools are free and there is no account to create. The OA
            Agent runs on Claude, so it needs an Anthropic API key — you use your
            own, and Anthropic bills you directly for the model usage. The Patent
            Reader and Antecedent Basis checker don't use AI models at all.
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</LandingLayout>
