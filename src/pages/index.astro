---
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingNav from '../components/landing/LandingNav.astro';
import Footer from '../components/landing/Footer.astro';
import { TOOLS } from '../navigation';

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Solve This OA For Me",
  url: "https://solvethisoaforme.chyuang.com",
  logo: "https://solvethisoaforme.chyuang.com/favicon.ico",
  applicationCategory: "BusinessApplication",
  description:
    "Free patent prosecution tools in the browser. A structured patent viewer, an AI agent that reads the cited prior art and recommends argue or amend, and an antecedent basis checker for amended claims. The agent runs on your own Anthropic API key.",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};

// The three tools, described by the job they do rather than by their name.
// Listed in the order an Office Action response actually gets written.
const tools = [
  {
    ...TOOLS[0],
    job: 'Read the cited art',
    blurb:
      'Enter a publication number and get claim dependency trees, reference numerals cross-linked to the figures, bounding boxes on the drawings, and multi-term search. Built for reading a reference the examiner cited against you.',
  },
  {
    ...TOOLS[1],
    job: 'Decide argue or amend',
    blurb:
      "An AI agent that follows the examiner's paragraph and column citations into the actual prior art, maps each claim limitation to the evidence relied on, and recommends argue or amend. Every conclusion cites a passage you can open and check.",
  },
  {
    ...TOOLS[2],
    job: 'Check your amendments',
    blurb:
      'Paste a claim set and get the §112 problems that creep in when claims are edited under time pressure — missing antecedent basis, ambiguous pronouns, unclear "such" phrases, prepositional scope, and silent reintroduction.',
  },
];
---

<LandingLayout
  title="Solve This OA For Me — Free Patent Prosecution Tools"
  description="Free tools for answering Office Actions: a structured patent viewer, an AI agent that reads the cited prior art on your own Anthropic API key, and an antecedent basis checker for amended claims."
>
  <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  <LandingNav />
  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden">
      <div class="absolute inset-0 bg-gradient-to-b from-amber-50/60 via-transparent to-transparent pointer-events-none"></div>
      <div class="relative max-w-5xl mx-auto px-6 pt-16 pb-12 md:pt-24 md:pb-16 text-center">
        <h1 class="text-4xl md:text-5xl font-bold text-stone-900 tracking-tight leading-[1.1] mb-6">
          Answering an Office Action,
          <span class="text-amber-600"> end to end</span>
        </h1>
        <p class="text-lg text-stone-500 leading-relaxed mb-8 max-w-2xl mx-auto">
          Three free tools for patent prosecution, right here in the browser. No
          account to create — the OA Agent runs on your own Anthropic API key, and
          the other two tools don't even need that.
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href="/oa-agent"
            class="inline-flex items-center gap-2 px-6 py-3 text-base font-medium text-white bg-amber-600 hover:bg-amber-700 rounded-lg transition-colors shadow-sm"
          >
            Start free
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a
            href="#how-it-works"
            class="inline-flex items-center gap-2 px-6 py-3 text-base font-medium text-stone-600 hover:text-stone-900 border border-stone-200 hover:border-stone-300 rounded-lg transition-colors"
          >
            How it works
          </a>
        </div>
        <p class="text-sm text-stone-500 mt-4">
          or <a href="/patent-reader" class="text-amber-700 underline underline-offset-2 hover:text-amber-800">try the Patent Reader</a> — nothing to set up
        </p>
        <p class="text-sm text-stone-400 mt-6 max-w-lg mx-auto">
          Your API key stays in this browser and goes straight to your agent
          session — it's never stored on the server.
        </p>
      </div>
    </section>

    <!-- Intro video -->
    <section class="pb-16 md:pb-20">
      <div class="max-w-4xl mx-auto px-6">
        <div class="relative rounded-2xl overflow-hidden shadow-xl border border-stone-200/60 bg-black">
          <video
            controls
            preload="metadata"
            poster="/intro-video-poster.jpg"
            class="w-full aspect-video"
          >
            <source src="/intro-video.mp4" type="video/mp4" />
          </video>
        </div>
        <p class="text-center text-sm text-stone-400 mt-4">
          The OA Agent in 40 seconds
        </p>
      </div>
    </section>

    <!-- The three tools, as one workflow -->
    <section class="py-16 md:py-24 bg-stone-50/70">
      <div class="max-w-5xl mx-auto px-6">
        <div class="max-w-2xl mb-12">
          <h2 class="text-2xl md:text-3xl font-bold text-stone-900 tracking-tight mb-4">
            Three tools, three jobs
          </h2>
          <p class="text-base text-stone-500 leading-relaxed">
            Responding to an Office Action means reading the art the examiner cited,
            working out which rejections to fight and which to amend around, and
            making sure the amendments hold up. Each tool covers one of those. They
            run independently — there's no shared pipeline between them.
          </p>
        </div>

        <div class="space-y-4">
          {tools.map(({ job, label, blurb, href }) => (
            <a
              href={href}
              class="group block p-6 md:p-7 rounded-2xl border border-stone-200 bg-white hover:border-amber-300 hover:shadow-lg transition-all"
            >
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-2">
                <h3 class="text-lg font-bold text-stone-900 group-hover:text-amber-700 transition-colors">{job}</h3>
                <span class="text-sm text-stone-400">{label}</span>
              </div>
              <p class="text-sm text-stone-500 leading-relaxed">{blurb}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section id="how-it-works" class="py-16 md:py-24 scroll-mt-16">
      <div class="max-w-5xl mx-auto px-6">
        <div class="max-w-2xl mb-10">
          <p class="text-sm font-medium text-amber-600 tracking-wide uppercase mb-3">How it works</p>
          <h2 class="text-2xl md:text-3xl font-bold text-stone-900 tracking-tight mb-4">
            Built to show its work
          </h2>
          <p class="text-base text-stone-500 leading-relaxed">
            The point is that you can check everything it tells you. Nothing it
            concludes is something you have to take on faith.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="p-6 rounded-2xl border border-stone-150 bg-stone-50/80">
            <h3 class="text-sm font-semibold text-stone-900 mb-2">It opens the documents</h3>
            <p class="text-sm text-stone-500 leading-relaxed">
              When the examiner cites column 5 of a reference, the agent opens that
              reference and reads column 5. It works from the files in front of it,
              not from what it remembers about the patent.
            </p>
          </div>
          <div class="p-6 rounded-2xl border border-stone-150 bg-stone-50/80">
            <h3 class="text-sm font-semibold text-stone-900 mb-2">You watch it work</h3>
            <p class="text-sm text-stone-500 leading-relaxed">
              You see which document it has open and which passage it's reading while
              it happens, rather than a summary afterwards. If it goes down the wrong
              path you'll know immediately.
            </p>
          </div>
          <div class="p-6 rounded-2xl border border-stone-150 bg-stone-50/80">
            <h3 class="text-sm font-semibold text-stone-900 mb-2">Every claim is traceable</h3>
            <p class="text-sm text-stone-500 leading-relaxed">
              Each conclusion points at the passage it came from. Click it, read the
              source, and decide for yourself whether the reasoning holds.
            </p>
          </div>
          <div class="p-6 rounded-2xl border border-stone-150 bg-stone-50/80">
            <h3 class="text-sm font-semibold text-stone-900 mb-2">Not everything is AI</h3>
            <p class="text-sm text-stone-500 leading-relaxed">
              The antecedent basis checker reads claim grammar directly rather than
              asking a model. It gives the same answer every time and can't invent a
              finding that isn't there.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- The honest asterisk -->
    <section class="py-12 md:py-16">
      <div class="max-w-3xl mx-auto px-6">
        <div class="p-7 md:p-8 rounded-2xl border border-amber-200 bg-amber-50/60">
          <h2 class="text-lg font-bold text-stone-900 mb-3">
            Free, with one honest asterisk
          </h2>
          <p class="text-sm text-stone-600 leading-relaxed">
            The tools cost nothing to use and there's nothing to sign up for. The
            OA Agent thinks with Claude, and model usage is the expensive part — so
            it runs on <em>your</em> Anthropic API key, and Anthropic bills you
            directly for exactly what your sessions use. No subscription, no
            markup, no pricing page. The Patent Reader and Antecedent Basis checker
            use no AI models, so they're simply free.
          </p>
        </div>
      </div>
    </section>

    <!-- Close -->
    <section class="py-16 md:py-24 bg-stone-50/70">
      <div class="max-w-3xl mx-auto px-6 text-center">
        <h2 class="text-2xl md:text-3xl font-bold text-stone-900 tracking-tight mb-4">
          Start in two minutes
        </h2>
        <p class="text-base text-stone-500 leading-relaxed mb-8 max-w-xl mx-auto">
          Open the OA Agent, paste your Anthropic API key in Settings, and drop in
          your Office Action. The Patent Reader and Antecedent Basis checker don't
          even need the key.
        </p>
        <a
          href="/oa-agent"
          class="inline-flex items-center gap-2 px-6 py-3 text-base font-medium text-white bg-amber-600 hover:bg-amber-700 rounded-lg transition-colors shadow-sm"
        >
          Start free
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </section>
  </main>
  <Footer />
</LandingLayout>
