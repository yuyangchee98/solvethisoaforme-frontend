---
import LandingLayout from '../layouts/LandingLayout.astro';
import LandingNav from '../components/landing/LandingNav.astro';
import Pricing from '../components/landing/Pricing.astro';
import Footer from '../components/landing/Footer.astro';

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Solve This OA For Me",
  url: "https://solvethisoaforme.chyuang.com",
  logo: "https://solvethisoaforme.chyuang.com/favicon.ico",
  description: "Patent tools for prosecution professionals. Free structured patent viewer with claim trees and reference mapping. AI-powered Office Action analysis with argue/amend recommendations.",
};
---

<LandingLayout title="Patent Tools for Prosecution | Solve This OA For Me">
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  <LandingNav />
  <main>
    <!-- Product cards -->
    <section class="pt-20 pb-12 md:pt-28 md:pb-16">
      <div class="max-w-5xl mx-auto px-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Patent Reader -->
          <a href="/patent-reader/about" class="group block p-8 rounded-xl border border-stone-200 bg-white hover:border-amber-300 hover:shadow-lg transition-all">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-lg bg-amber-100 flex items-center justify-center">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-amber-600"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
              </div>
              <div>
                <h2 class="text-xl font-bold text-stone-900">Patent Reader</h2>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[11px] font-medium bg-amber-100 text-amber-700">Free</span>
              </div>
            </div>
            <p class="text-sm text-stone-500 leading-relaxed mb-6">
              A structured patent viewer built for patent professionals. Enter any patent number and get claim dependency trees, reference numeral mapping, figure bounding boxes, side-by-side comparison, and multi-term search.
            </p>
            <span class="inline-flex items-center gap-1 text-sm font-medium text-amber-600 group-hover:text-amber-700 transition-colors">
              Learn more
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </span>
          </a>

          <!-- OA Response Agent -->
          <a href="/oa-response/about" class="group block p-8 rounded-xl border border-stone-200 bg-white hover:border-amber-300 hover:shadow-lg transition-all">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-10 h-10 rounded-lg bg-amber-100 flex items-center justify-center">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-amber-600"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
              </div>
              <h2 class="text-xl font-bold text-stone-900">OA Response Agent</h2>
            </div>
            <p class="text-sm text-stone-500 leading-relaxed mb-6">
              Upload your Office Action and let AI analyze every rejection, read the cited prior art, and recommend argue-or-amend strategies. Every conclusion cites a specific passage you can verify yourself.
            </p>
            <span class="inline-flex items-center gap-1 text-sm font-medium text-amber-600 group-hover:text-amber-700 transition-colors">
              Learn more
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </span>
          </a>
        </div>
      </div>
    </section>

    <!-- About -->
    <section class="py-16 md:py-24 bg-stone-50/70">
      <div class="max-w-3xl mx-auto px-6">
        <h2 class="text-2xl md:text-3xl font-bold text-stone-900 tracking-tight mb-4">
          Patent tools built for patent work
        </h2>
        <div class="space-y-4 text-base text-stone-500 leading-relaxed">
          <p>
            Most patent tools are built by software companies that treat patents like any other document. The result is generic viewers, generic AI, and workflows that don't match how prosecution actually works.
          </p>
          <p>
            Solve This OA For Me is built specifically for patent prosecution. The patent viewer understands claim dependencies, reference numerals, and figure annotations. The OA agent reads the actual cited prior art, follows the examiner's specific paragraph and column citations, and maps claim elements to references — the same mechanical work you do before you can start thinking about strategy.
          </p>
        </div>
      </div>
    </section>

    <!-- Patent Reader detail -->
    <section class="py-16 md:py-24">
      <div class="max-w-5xl mx-auto px-6">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-10 h-10 rounded-lg bg-amber-100 flex items-center justify-center">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-amber-600"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
          </div>
          <div>
            <h2 class="text-2xl md:text-3xl font-bold text-stone-900 tracking-tight">Patent Reader</h2>
          </div>
        </div>
        <p class="text-base text-stone-500 leading-relaxed mb-8 max-w-2xl">
          Enter a patent number like you would on Google Patents — but get claim dependency trees, reference numeral mapping, figure bounding boxes, and side-by-side comparison. Free, no account required.
        </p>

        <!-- Bento grid -->
        <div class="grid grid-cols-1 md:grid-cols-6 gap-3">
          <!-- Claim trees — wide -->
          <div class="md:col-span-4 p-6 rounded-2xl border border-stone-150 bg-stone-50/80">
            <div class="w-9 h-9 rounded-lg bg-amber-100/80 flex items-center justify-center mb-3">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-amber-600"><line x1="6" y1="3" x2="6" y2="15"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M18 9a9 9 0 0 1-9 9"/></svg>
            </div>
            <h3 class="text-sm font-semibold text-stone-900 mb-1">Claim dependency trees</h3>
            <p class="text-sm text-stone-500 leading-relaxed">Independent and dependent claims in a collapsible tree. See which claims depend on which at a glance, click any node to jump to the claim text.</p>
          </div>

          <!-- Reference numerals — tall -->
          <div class="md:col-span-2 md:row-span-2 p-6 rounded-2xl border border-stone-150 bg-stone-50/80 flex flex-col">
            <div class="w-9 h-9 rounded-lg bg-amber-100/80 flex items-center justify-center mb-3">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-amber-600"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>
            </div>
            <h3 class="text-sm font-semibold text-stone-900 mb-1">Reference numeral mapping</h3>
            <p class="text-sm text-stone-500 leading-relaxed">Every reference numeral extracted with its description and occurrence count. Click any numeral to cross-highlight it in the text, figures, and sidebar — or expand it to browse each occurrence with surrounding context.</p>
          </div>

          <!-- Figure bounding boxes -->
          <div class="md:col-span-2 p-6 rounded-2xl border border-stone-150 bg-stone-50/80">
            <div class="w-9 h-9 rounded-lg bg-amber-100/80 flex items-center justify-center mb-3">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-amber-600"><path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/><circle cx="12" cy="12" r="3"/></svg>
            </div>
            <h3 class="text-sm font-semibold text-stone-900 mb-1">Figure bounding boxes</h3>
            <p class="text-sm text-stone-500 leading-relaxed">Reference numerals overlaid on patent figures as clickable boxes. Select a numeral in the text and see it on the drawing.</p>
          </div>

          <!-- Side-by-side -->
          <div class="md:col-span-2 p-6 rounded-2xl border border-stone-150 bg-stone-50/80">
            <div class="w-9 h-9 rounded-lg bg-amber-100/80 flex items-center justify-center mb-3">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-amber-600"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M12 3v18"/></svg>
            </div>
            <h3 class="text-sm font-semibold text-stone-900 mb-1">Side-by-side comparison</h3>
            <p class="text-sm text-stone-500 leading-relaxed">Compare two patents side by side. Each panel has its own figures, search, and reference numeral state.</p>
          </div>

          <!-- Search — wide -->
          <div class="md:col-span-3 p-6 rounded-2xl border border-stone-150 bg-stone-50/80">
            <div class="w-9 h-9 rounded-lg bg-amber-100/80 flex items-center justify-center mb-3">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-amber-600"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
            </div>
            <h3 class="text-sm font-semibold text-stone-900 mb-1">Multi-term search</h3>
            <p class="text-sm text-stone-500 leading-relaxed">Search for multiple terms at once, each color-coded. Browse occurrences by section with case-sensitive and whole-word matching.</p>
          </div>

          <!-- Any patent -->
          <div class="md:col-span-3 p-6 rounded-2xl border border-stone-150 bg-stone-50/80">
            <div class="w-9 h-9 rounded-lg bg-amber-100/80 flex items-center justify-center mb-3">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-amber-600"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
            </div>
            <h3 class="text-sm font-semibold text-stone-900 mb-1">Any patent number</h3>
            <p class="text-sm text-stone-500 leading-relaxed">US, EP, CN, JP, KR, PCT, and more. Paste a patent or publication number and get the full document instantly.</p>
          </div>
        </div>

        <div class="mt-8 flex items-center gap-3">
          <a
            href="/patent-reader?patent=US11423567B2"
            class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-medium text-white bg-amber-600 hover:bg-amber-700 rounded-lg transition-colors shadow-sm"
          >
            Try on a real patent
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a
            href="/patent-reader/about"
            class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-medium text-stone-600 hover:text-stone-900 border border-stone-200 hover:border-stone-300 rounded-lg transition-colors"
          >
            Learn more
          </a>
        </div>

        <!-- Static product mock -->
        <div class="mt-12 rounded-xl border border-stone-200/80 bg-white shadow-lg overflow-hidden">
          <!-- App chrome bar -->
          <div class="flex items-center justify-between px-4 py-2.5 bg-stone-50 border-b border-stone-100">
            <div class="flex items-center gap-3">
              <div class="flex gap-1.5">
                <div class="w-2.5 h-2.5 rounded-full bg-stone-200"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-stone-200"></div>
                <div class="w-2.5 h-2.5 rounded-full bg-stone-200"></div>
              </div>
              <span class="text-[11px] font-medium text-stone-400">Patent Reader</span>
            </div>
            <div class="px-2 py-0.5 rounded bg-stone-100 text-[10px] text-stone-400 font-medium">US11423567B2</div>
          </div>

          <!-- Patent title bar -->
          <div class="px-4 py-2 border-b border-stone-100 bg-white">
            <p class="text-[12px] font-medium text-stone-700 truncate">Methods and systems for detecting head location and orientation using sensor data</p>
          </div>

          <!-- 2-panel layout -->
          <div class="flex" style="min-height: 280px;">
            <!-- Main content -->
            <div class="flex-1 p-4 border-r border-stone-100 bg-stone-50/50 overflow-hidden">
              <p class="text-[11px] font-semibold text-stone-400 uppercase tracking-wider mb-2">Description</p>
              <div class="space-y-3 text-[11px] text-stone-700 leading-relaxed">
                <div class="flex gap-2">
                  <span class="text-[10px] font-mono text-stone-300 select-none pt-1 shrink-0 w-10 text-right">[0003]</span>
                  <p><span class="text-blue-600 font-medium">FIG. 1</span> illustrates an exemplary system <span class="font-mono text-[0.8em] text-amber-700 bg-amber-100/50 rounded px-0.5">100</span> for head tracking. The system <span class="font-mono text-[0.8em] text-amber-700 bg-amber-100/50 rounded px-0.5">100</span> includes a <mark class="bg-yellow-200/70 rounded-sm px-0.5">sensor</mark> array <span class="font-mono text-[0.8em] text-amber-700 bg-amber-100/50 rounded px-0.5">102</span> and a processing unit <span class="font-mono text-[0.8em] text-stone-400 rounded px-0.5">104</span>.</p>
                </div>
                <div class="flex gap-2">
                  <span class="text-[10px] font-mono text-stone-300 select-none pt-1 shrink-0 w-10 text-right">[0004]</span>
                  <p>The <mark class="bg-yellow-200/70 rounded-sm px-0.5">sensor</mark> array <span class="font-mono text-[0.8em] text-amber-700 bg-amber-100/50 rounded px-0.5">102</span> comprises one or more <mark class="bg-green-200/70 rounded-sm px-0.5">depth</mark> <mark class="bg-yellow-200/70 rounded-sm px-0.5">sensor</mark>s configured to capture three-dimensional point cloud data.</p>
                </div>
                <div class="flex gap-2">
                  <span class="text-[10px] font-mono text-stone-300 select-none pt-1 shrink-0 w-10 text-right">[0005]</span>
                  <p>The processing unit <span class="font-mono text-[0.8em] text-stone-400 rounded px-0.5">104</span> receives the point cloud data and generates a <mark class="bg-green-200/70 rounded-sm px-0.5">depth</mark> map representing the spatial distribution of surfaces in the captured scene.</p>
                </div>
              </div>

              <p class="text-[11px] font-semibold text-stone-400 uppercase tracking-wider mb-2 mt-5">Claims</p>
              <div class="space-y-2">
                <div class="flex items-start gap-2">
                  <span class="text-[10px] font-mono font-medium text-stone-400 shrink-0 w-5 text-right pt-0.5 select-none">1.</span>
                  <p class="text-[11px] text-stone-700 leading-relaxed">A method for detecting head location and orientation, the method comprising: receiving, by a processor, image data from a <mark class="bg-yellow-200/70 rounded-sm px-0.5">sensor</mark> array <span class="font-mono text-[0.8em] text-amber-700 bg-amber-100/50 rounded px-0.5">102</span>; generating a <mark class="bg-green-200/70 rounded-sm px-0.5">depth</mark> map...</p>
                </div>
                <div class="flex items-start gap-2">
                  <span class="text-[10px] font-mono font-medium text-stone-400 shrink-0 w-5 text-right pt-0.5 select-none">2.</span>
                  <p class="text-[11px] text-stone-700 leading-relaxed">The method of <span class="text-violet-600 font-medium">claim 1</span>, wherein the <mark class="bg-yellow-200/70 rounded-sm px-0.5">sensor</mark> comprises a <mark class="bg-green-200/70 rounded-sm px-0.5">depth</mark> camera configured to capture infrared structured light patterns.</p>
                </div>
              </div>
            </div>

            <!-- Right sidebar -->
            <div class="w-64 shrink-0 hidden md:flex flex-col overflow-hidden">
              <div class="flex items-center gap-4 px-4 pt-3 pb-0 border-b border-stone-100">
                <span class="text-[11px] pb-2 border-b-2 font-semibold text-stone-800 border-amber-500">Figures</span>
                <span class="text-[11px] pb-2 border-b-2 font-medium text-stone-400 border-transparent">Details</span>
                <span class="text-[11px] pb-2 border-b-2 font-medium text-stone-400 border-transparent">Search</span>
              </div>
              <div class="p-3">
                <!-- Figure with block diagram -->
                <div class="rounded-lg bg-white border border-stone-200 p-3 mb-3">
                  <svg viewBox="0 0 240 160" class="w-full" xmlns="http://www.w3.org/2000/svg">
                    <rect x="10" y="10" width="220" height="130" rx="3" fill="none" stroke="#78716c" stroke-width="1" stroke-dasharray="4 2"/>
                    <text x="20" y="26" font-size="8" font-family="monospace" fill="#78716c">100</text>
                    <rect x="25" y="45" width="80" height="50" rx="2" fill="none" stroke="#292524" stroke-width="1.2"/>
                    <text x="65" y="68" font-size="8" text-anchor="middle" font-family="system-ui" fill="#292524">Sensor Array</text>
                    <text x="65" y="82" font-size="8" text-anchor="middle" font-family="monospace" fill="#78716c">102</text>
                    <rect x="140" y="45" width="80" height="50" rx="2" fill="none" stroke="#292524" stroke-width="1.2"/>
                    <text x="180" y="68" font-size="8" text-anchor="middle" font-family="system-ui" fill="#292524">Processing Unit</text>
                    <text x="180" y="82" font-size="8" text-anchor="middle" font-family="monospace" fill="#78716c">104</text>
                    <line x1="105" y1="70" x2="140" y2="70" stroke="#292524" stroke-width="1.2"/>
                    <polygon points="137,67 140,70 137,73" fill="#292524"/>
                    <text x="122" y="64" font-size="7" text-anchor="middle" font-family="monospace" fill="#78716c">106</text>
                    <!-- Bounding box overlays -->
                    <rect x="52" y="74" width="26" height="14" rx="1" fill="rgba(245,158,11,0.15)" stroke="rgba(245,158,11,0.6)" stroke-width="0.8"/>
                    <rect x="167" y="74" width="26" height="14" rx="1" fill="rgba(245,158,11,0.15)" stroke="rgba(245,158,11,0.6)" stroke-width="0.8"/>
                    <rect x="112" y="56" width="20" height="12" rx="1" fill="rgba(245,158,11,0.15)" stroke="rgba(245,158,11,0.6)" stroke-width="0.8"/>
                    <text x="120" y="155" font-size="9" text-anchor="middle" font-family="system-ui" font-weight="500" fill="#57534e">FIG. 1</text>
                  </svg>
                </div>

                <!-- Elements on sheet -->
                <p class="text-[10px] font-medium text-stone-400 uppercase tracking-wide mb-2">Elements on sheet</p>
                <div class="space-y-1">
                  <div class="flex items-center gap-2 p-1 rounded">
                    <span class="text-[10px] font-mono font-bold text-amber-700 bg-amber-100/70 px-1.5 py-0.5 rounded">100</span>
                    <span class="text-[10px] text-stone-500">head tracking system</span>
                  </div>
                  <div class="flex items-center gap-2 p-1 rounded bg-amber-50/60">
                    <span class="text-[10px] font-mono font-bold text-amber-700 bg-amber-100/70 px-1.5 py-0.5 rounded">102</span>
                    <span class="text-[10px] text-stone-500">sensor array</span>
                  </div>
                  <div class="flex items-center gap-2 p-1 rounded">
                    <span class="text-[10px] font-mono font-bold text-amber-700 bg-amber-100/70 px-1.5 py-0.5 rounded">104</span>
                    <span class="text-[10px] text-stone-500">processing unit</span>
                  </div>
                  <div class="flex items-center gap-2 p-1 rounded">
                    <span class="text-[10px] font-mono font-bold text-amber-700 bg-amber-100/70 px-1.5 py-0.5 rounded">106</span>
                    <span class="text-[10px] text-stone-500">data bus</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- OA Response Agent detail -->
    <section class="py-16 md:py-24 bg-stone-50/70">
      <div class="max-w-5xl mx-auto px-6">
        <div class="flex items-center gap-3 mb-3">
          <div class="w-10 h-10 rounded-lg bg-amber-100 flex items-center justify-center">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-amber-600"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          </div>
          <h2 class="text-2xl md:text-3xl font-bold text-stone-900 tracking-tight">OA Response Agent</h2>
        </div>
        <p class="text-base text-stone-500 leading-relaxed mb-8 max-w-2xl">
          Upload your Office Action and your application. The AI reads the cited prior art, maps each claim limitation to the examiner's cited evidence, and recommends whether to argue or amend.
        </p>

        <!-- Bento grid -->
        <div class="grid grid-cols-1 md:grid-cols-6 gap-3">
          <!-- Reads prior art — wide -->
          <div class="md:col-span-3 p-6 rounded-2xl border border-stone-200 bg-white">
            <div class="w-9 h-9 rounded-lg bg-amber-100/80 flex items-center justify-center mb-3">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-amber-600"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
            </div>
            <h3 class="text-sm font-semibold text-stone-900 mb-1">Reads the actual prior art</h3>
            <p class="text-sm text-stone-500 leading-relaxed">Follows the examiner's specific paragraph and column citations to the relevant passages. Checks whether they actually teach what the examiner says.</p>
          </div>

          <!-- Maps elements — wide -->
          <div class="md:col-span-3 p-6 rounded-2xl border border-stone-200 bg-white">
            <div class="w-9 h-9 rounded-lg bg-amber-100/80 flex items-center justify-center mb-3">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-amber-600"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
            </div>
            <h3 class="text-sm font-semibold text-stone-900 mb-1">Maps claim elements to references</h3>
            <p class="text-sm text-stone-500 leading-relaxed">For every rejection, maps each claim limitation to the passage the examiner relies on. For combinations, shows which element comes from which reference.</p>
          </div>

          <!-- Argue/amend — tall -->
          <div class="md:col-span-2 md:row-span-2 p-6 rounded-2xl border border-stone-200 bg-white flex flex-col">
            <div class="w-9 h-9 rounded-lg bg-amber-100/80 flex items-center justify-center mb-3">
