---
import Layout from '../layouts/Layout.astro';
import TopNav from '../components/layout/TopNav.astro';
import Footer from '../components/landing/Footer.astro';
import AntecedentBasisAbout from '../components/landing/AntecedentBasisAbout.astro';
import AntecedentBasisChecker from '../components/AntecedentBasisChecker';
---

<Layout
  title="Antecedent Basis Checker for Patent Claims"
  description="Free antecedent basis checker for patent claims. Catches missing antecedents, pronouns, 'such' phrases, prepositional scope, and reintroduction in patent claims."
>
  <TopNav />

  <main>
    <div id="app" class="min-h-screen bg-stone-50">
      <AntecedentBasisChecker client:load />
    </div>
    <AntecedentBasisAbout />
  </main>
  <Footer />
</Layout>
